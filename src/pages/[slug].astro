const rates=[15,20,25,30,35,40,50];
export function getStaticPaths(){const rates=[15,20,25,30,35,40,50];return rates.map(rate=>({params:{slug:`${rate}-an-hour-is-how-much-a-year`},props:{rate}}))}
const {rate}=Astro.props;
const annual=rate*2080,monthly=annual/12,weekly=rate*40,biweekly=weekly*2;
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const title=`$${rate} an Hour Is How Much a Year? ${money(annual)} Annual Salary`;
const description=`$${rate} an hour is ${money(annual)} a year before taxes at 40 hours/week. See monthly, biweekly, part-time and unpaid vacation pay, and calculate your own hours.`;
const canonical=`https://hourlyincomecalculator.com/${rate}-an-hour-is-how-much-a-year/`;
const schedules=[20,30,35,37.5,40].map(h=>({hours:h,annual:rate*h*52,monthly:rate*h*52/12}));
const faq=[{q:`How much is $${rate} an hour annually?`,a:`$${rate} an hour is ${money(annual)} annually before taxes at 40 hours per week and 52 weeks per year.`},{q:`How much is ${rate} dollars an hour annually?`,a:`Working full-time, ${rate} dollars an hour works out to ${money(annual)} gross annually, or ${money(monthly)} per month on average.`},{q:`How much is $${rate} an hour at 30 hours a week?`,a:`At 30 hours a week and 52 paid weeks, the annual gross pay is ${money(rate*30*52)}.`},{q:'Does this include income taxes?',a:'No. These are gross earnings. Actual take-home pay depends on where you live, filing status, payroll taxes and other deductions.'}];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(x=>({"@type":"Question",name:x.q,acceptedAnswer:{"@type":"Answer",text:x.a}}))})}></script></head>
<body><header><a class="logo" href="/">$ hourly<span>income.</span></a><nav><a href="/">Full calculator</a><a href="#breakdown">Pay breakdown</a><a href="#questions">FAQ</a></nav></header><main><div class="breadcrumb"><a href="/">Hourly Income Calculator</a> / {rate} an hour</div><section class="hero"><div class="eyebrow">HOURLY TO ANNUAL SALARY</div><h1>How much is <em>{rate} an hour</em> annually?</h1><p class="intro">At 40 hours a week for 52 paid weeks, {rate} an hour is <strong>{money(annual)} per year before taxes.</strong> Change the hours below to see what you would earn.</p>
<div class="workspace"><div class="inputs"><div class="eyebrow">CALCULATE YOUR PAY</div><label for="rate">Hourly wage ($)</label><input id="rate" type="number" min="0" max="100000000" step=".5" value={rate}/><div class="two"><div><label for="hours">Hours / week</label><input id="hours" type="number" min="0" max="168" value="40"/></div><div><label for="weeks">Paid weeks / year</label><input id="weeks" type="number" min="0" max="52" value="52"/></div></div><p class="helper">Results update as you type. All amounts are before tax.</p><div class="actions"><button id="save" type="button">↓ Save image</button><button id="share" type="button">↗ Share result</button></div><p id="status" role="status" aria-live="polite"></p></div><div class="output"><div class="eyebrow">YOUR ANNUAL INCOME · BEFORE TAX</div><output id="annual">{money(annual)}</output><div class="bill" aria-hidden="true"><span>100</span><b>$</b><span>100</span></div><div class="stats"><div><small>Monthly</small><strong id="monthly">{money(monthly)}</strong></div><div><small>Biweekly</small><strong id="biweekly">{money(biweekly)}</strong></div><div><small>Weekly</small><strong id="weekly">{money(weekly)}</strong></div><div><small>Daily (8h)</small><strong id="daily">{money(rate*8)}</strong></div></div></div></div></section>
<section class="content" id="breakdown"><h2>{rate} an hour: full pay breakdown</h2><p>With a standard 40-hour workweek, you work 2,080 paid hours in a 52-week year. Your annual gross salary is calculated as <strong>{rate} × 40 × 52 = {money(annual)}</strong>.</p><div class="tablewrap"><table><thead><tr><th>Pay period</th><th>Gross earnings</th></tr></thead><tbody><tr><td>8-hour workday</td><td>{money(rate*8)}</td></tr><tr><td>Week (40 hours)</td><td>{money(weekly)}</td></tr><tr><td>Every two weeks</td><td>{money(biweekly)}</td></tr><tr><td>Twice a month</td><td>{money(annual/24)}</td></tr><tr><td>Average month</td><td>{money(monthly)}</td></tr><tr><td>Year (52 weeks)</td><td>{money(annual)}</td></tr></tbody></table></div><h2>What if you work part-time?</h2><p>Not everyone works 40 hours every week. Compare different schedules at the same hourly rate:</p><div class="tablewrap"><table><thead><tr><th>Hours per week</th><th>Monthly average</th><th>Annual gross</th></tr></thead><tbody>{schedules.map(s=><tr><td>{s.hours} hours</td><td>{money(s.monthly)}</td><td>{money(s.annual)}</td></tr>)}</tbody></table></div><h2>How unpaid time off changes your income</h2><p>If you are not paid during time off, 50 working weeks instead of 52 means <strong>{money(rate*40*50)}</strong> annually. If your vacation is paid, keep those weeks in the calculation. The calculator above lets you adjust this assumption directly.</p><h2>What about take-home pay after taxes?</h2><p>These figures are <strong>gross income</strong>, not the amount deposited into your bank account. US federal income tax, Social Security, Medicare and applicable state and local taxes can change your take-home pay. We do not show a generic tax estimate because it could be misleading without your location and filing details.</p></section><section class="content" id="questions"><h2>Frequently asked questions</h2>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}<div class="related"><h2>Explore more hourly rates</h2>{rates.filter(n=>n!==rate).map(n=><a href={`/${n}-an-hour-is-how-much-a-year/`}>${n} an hour is how much a year? →</a>)}<a href="/">Try the full multi-currency calculator →</a><a href="/salary-to-hourly-calculator/">Convert annual salary to hourly pay →</a></div></section></main><footer><a href="/">Hourly Income Calculator</a><span>Free, private, and calculated in your browser.</span></footer>
<script>
const $=s=>document.querySelector(s),rate=$('#rate'),hours=$('#hours'),weeks=$('#weeks');const format=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(n);const vals=()=>{const r=Math.max(0,Math.min(100000000,Number(rate.value)||0)),h=Math.max(0,Math.min(168,Number(hours.value)||0)),w=Math.max(0,Math.min(52,Number(weeks.value)||0));return {r,h,w,a:r*h*w}};const update=()=>{const {r,h,a}=vals();$('#annual').textContent=format(a);$('#monthly').textContent=format(a/12);$('#biweekly').textContent=format(a/26);$('#weekly').textContent=format(r*h);$('#daily').textContent=format(r*8)};[rate,hours,weeks].forEach(el=>el.addEventListener('input',update));update();
const url=()=>{const u=new URL('/',location.origin);u.searchParams.set('rate',rate.value);u.searchParams.set('hours',hours.value);u.searchParams.set('weeks',weeks.value);u.searchParams.set('currency','USD');return u.href};
$('#share').addEventListener('click',async()=>{const text='My annual gross pay: '+$('#annual').textContent+' — calculate yours!';try{if(navigator.share)await navigator.share({title:'My hourly income',text,url:url()});else if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(text+' '+url());$('#status').textContent='Link copied!'}else $('#status').textContent='Share link: '+url()}catch(e){if(e.name!=='AbortError')$('#status').textContent='Sharing unavailable.'}});
$('#save').addEventListener('click',()=>{const c=document.createElement('canvas');c.width=1080;c.height=1350;const x=c.getContext('2d');if(!x)return;const {r,h,w,a}=vals();x.fillStyle='#f6f9f3';x.fillRect(0,0,1080,1350);x.fillStyle='#fff';x.fillRect(55,55,970,1240);const t=(s,y,size,color='#225c3d')=>{x.fillStyle=color;x.font='bold '+size+'px system-ui';x.fillText(s,105,y)};t('hourlyincome.',165,48);t('EVERY HOUR COUNTS',260,28,'#839c86');t('My annual income',355,55,'#21372a');let size=98;x.font='bold '+size+'px system-ui';while(x.measureText(format(a)).width>855&&size>40){size-=2;x.font='bold '+size+'px system-ui'}t(format(a),510,size);t(format(r)+' per hour',585,43);t(h+' hours/week · '+w+' weeks/year',665,28,'#78917d');t('Monthly: '+format(a/12),815,42);t('Biweekly: '+format(a/26),910,42);t('Weekly: '+format(r*h),1005,42);t('Before taxes and deductions',1130,27,'#839c86');t('hourlyincomecalculator.com',1230,33);c.toBlob(blob=>{if(!blob)return;const u=URL.createObjectURL(blob),link=document.createElement('a');link.href=u;link.download='hourly-income.png';link.click();setTimeout(()=>URL.revokeObjectURL(u),1000)},'image/png')});
</script></body></html>
