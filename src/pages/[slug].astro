---
import BrandLogo from '../components/BrandLogo.astro';
import { SALARIES, salarySlug, HOURLY_RATES, FEATURED_RATES, rateSlug, US_MEDIAN_HOURLY } from '../lib/salary-pages.js';
import { estimateFederalTax, estimateEmployeeFica, estimateWeeklyOvertime } from '../lib/us-federal-tax.js';
export function getStaticPaths(){return HOURLY_RATES.map(rate=>({params:{slug:rateSlug(rate)},props:{rate}}))}
const {rate}=Astro.props;
const annual=rate*2080,monthly=annual/12,weekly=rate*40,biweekly=annual/26;
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const title=`How Much Is $${rate} an Hour Annually? ${money(annual)} a Year`;
const takeHome=['single','married_joint'].map(status=>{const tax=estimateFederalTax(annual,status).federalTax,fica=estimateEmployeeFica(annual,status).total,net=annual-tax-fica;return {status,tax,fica,net,monthly:net/12,biweekly:net/26};});
const netSingle=takeHome[0].net;
const overtimeRows=[40,45,50,55,60].map(hours=>({...estimateWeeklyOvertime(rate,hours),hours}));
const medianDiff=rate-US_MEDIAN_HOURLY.value;
const medianDescription=`$${rate} an hour is $${Math.abs(medianDiff).toFixed(2)} (${Math.round(Math.abs(medianDiff)/US_MEDIAN_HOURLY.value*100)}%) ${medianDiff>=0?'above':'below'} the US median hourly wage of $24.51 for all occupations (BLS, May 2025).`;
const currentIndex=HOURLY_RATES.indexOf(rate);
const nearby=HOURLY_RATES.slice(Math.max(0,currentIndex-2),Math.min(HOURLY_RATES.length,currentIndex+3)).filter(n=>n!==rate);
const description=`$${rate} an hour (${rate} dollars an hour) is ${money(annual)} annually before taxes, about ${money(netSingle)} after federal taxes for a single filer. Plus monthly and overtime pay.`;
const canonical=`https://hourlyincomecalculator.com/${rate}-an-hour-is-how-much-a-year/`;
const paidWeekOptions=[52,50,48,46].map(weeks=>({weeks,annual:rate*40*weeks,lost:rate*40*(52-weeks)}));
const schedules=[20,30,35,37.5,40].map(h=>({hours:h,annual:rate*h*52,monthly:rate*h*52/12}));
const faq=[{q:`How much is $${rate} an hour annually?`,a:`$${rate} an hour is ${money(annual)} annually before taxes at 40 hours per week and 52 weeks per year.`},{q:`How much is ${rate} dollars an hour annually?`,a:`Working full-time, ${rate} dollars an hour works out to ${money(annual)} gross annually, or ${money(monthly)} per month on average.`},{q:`How much is $${rate} an hour at 30 hours a week?`,a:`At 30 hours a week and 52 paid weeks, the annual gross pay is ${money(rate*30*52)}.`},{q:'Does this include income taxes?',a:'The pay breakdown is gross income. The federal take-home estimate excludes state and local taxes and other deductions.'},{q:`How much is $${rate} an hour annually after taxes?`,a:`About ${money(takeHome[0].net)} for a single filer, or ${money(takeHome[1].net)} for married filing jointly, after estimated 2026 federal income and payroll taxes. State taxes are excluded.`},{q:`How much is $${rate} an hour annually with overtime?`,a:`At 50 hours a week, eligible non-exempt employees could earn ${money(estimateWeeklyOvertime(rate,50).weeklyGross*52)} annually before taxes using 1.5 times pay for hours over 40.`},{q:`How does $${rate} an hour compare to the median wage?`,a:medianDescription}];
---
<!doctype html><html lang="en"><head><meta name="theme-color" content="#f5c928"/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/gold-coin.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(x=>({"@type":"Question",name:x.q,acceptedAnswer:{"@type":"Answer",text:x.a}}))})}></script><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hourly Income Calculator",item:"https://hourlyincomecalculator.com/"},{"@type":"ListItem",position:2,name:`${rate} an hour`,item:canonical}]})}></script></head>
<body><header><BrandLogo /><nav><a href="/">Full calculator</a><a href="#breakdown">Pay breakdown</a><a href="#questions">FAQ</a></nav></header><main><div class="breadcrumb"><a href="/">Hourly Income Calculator</a> / {`${rate} an hour`}</div><section class="hero"><div class="eyebrow">HOURLY TO ANNUAL SALARY</div><h1>How much is <em>${rate} an hour</em> annually?</h1><p class="intro"><strong>${rate} an hour ({rate} dollars an hour) is {money(annual)} annually before taxes,</strong> based on 40 hours a week for 52 paid weeks. Change the hours below to calculate your pay.</p>
<div class="workspace"><div class="inputs"><div class="eyebrow">CALCULATE YOUR PAY</div><label for="rate">Hourly wage ($)</label><input id="rate" type="number" min="0" max="100000000" step=".5" value={rate}/><div class="two"><div><label for="hours">Hours / week</label><input id="hours" type="number" min="0" max="168" value="40"/></div><div><label for="weeks">Paid weeks / year</label><input id="weeks" type="number" min="0" max="52" value="52"/></div></div><p class="helper">Results update as you type. All amounts are before tax.</p><div class="actions"><button id="save" type="button">↓ Save image</button><button id="share" type="button">↗ Share result</button></div><p id="status" role="status" aria-live="polite"></p></div><div class="output"><div class="eyebrow">YOUR ANNUAL INCOME · BEFORE TAX</div><output id="annual">{money(annual)}</output><div class="bill" aria-hidden="true"><span>100</span><b>$</b><span>100</span></div><div class="stats"><div><small>Monthly</small><strong id="monthly">{money(monthly)}</strong></div><div><small>Biweekly</small><strong id="biweekly">{money(biweekly)}</strong></div><div><small>Weekly</small><strong id="weekly">{money(weekly)}</strong></div><div><small>Daily (8h)</small><strong id="daily">{money(rate*8)}</strong></div></div></div></div></section>
<section class="content" id="breakdown"><h2>${rate} an hour annually: full pay breakdown</h2><p>With a standard 40-hour workweek, you work 2,080 paid hours in a 52-week year. Your annual gross salary is calculated as <strong>{rate} × 40 × 52 = {money(annual)}</strong>.</p><div class="tablewrap"><table><thead><tr><th>Pay period</th><th>Gross earnings</th></tr></thead><tbody><tr><td>8-hour workday</td><td>{money(rate*8)}</td></tr><tr><td>Week (40 hours)</td><td>{money(weekly)}</td></tr><tr><td>Every two weeks</td><td>{money(biweekly)}</td></tr><tr><td>Twice a month</td><td>{money(annual/24)}</td></tr><tr><td>Average month</td><td>{money(monthly)}</td></tr><tr><td>Year (52 weeks)</td><td>{money(annual)}</td></tr></tbody></table></div><h2>How much is ${rate} an hour annually after taxes?</h2><p>For a single filer in 2026, ${rate} an hour is about <strong>{money(netSingle)} a year</strong> after estimated federal income tax, Social Security and Medicare, or {money(takeHome[0].monthly)} per month.</p><div class="tablewrap"><table><thead><tr><th>Filing status</th><th>Annual gross</th><th>Federal income tax</th><th>Social Security + Medicare</th><th>Annual after federal taxes</th><th>Monthly</th><th>Biweekly</th></tr></thead><tbody>{takeHome.map(row=><tr><td>{row.status==='single'?'Single':'Married filing jointly'}</td><td>{money(annual)}</td><td>{money(row.tax)}</td><td>{money(row.fica)}</td><td>{money(row.net)}</td><td>{money(row.monthly)}</td><td>{money(row.biweekly)}</td></tr>)}</tbody></table></div><p class="tax-note">Estimate uses 2026 federal tax brackets and the standard deduction (<a href="https://www.irs.gov/irb/2025-45_IRB">IRS Rev. Proc. 2025-32</a>), plus employee Social Security (6.2%) and Medicare (1.45%). It does not include state or local income tax, health insurance, retirement contributions or tax credits. This is not an actual paycheck or withholding estimate. <a href={`/us-federal-take-home-pay-calculator/?rate=${rate}&hours=40&weeks=52&status=single`}>Calculate your own take-home pay →</a></p><p><strong>US wage comparison:</strong> {medianDescription} <a href={US_MEDIAN_HOURLY.url}>Source: US Bureau of Labor Statistics</a>.</p><h2>How much is ${rate} an hour annually with overtime?</h2><p>If you are a covered non-exempt hourly worker, hours over 40 in a workweek are generally paid at 1.5× ({money(rate*1.5)} per hour). At 50 hours per week for 52 weeks, that is <strong>{money(estimateWeeklyOvertime(rate,50).weeklyGross*52)} gross annually</strong>.</p><div class="tablewrap"><table><thead><tr><th>Hours / week</th><th>Overtime hours</th><th>Weekly gross</th><th>Annual gross (52 weeks)</th></tr></thead><tbody>{overtimeRows.map(row=><tr><td>{row.hours}</td><td>{row.overtimeHours}</td><td>{money(row.weeklyGross)}</td><td>{money(row.weeklyGross*52)}</td></tr>)}</tbody></table></div><p>Overtime rules follow the Fair Labor Standards Act; exempt employees and some industries may not be covered. <a href="https://www.dol.gov/agencies/whd/overtime">US Department of Labor overtime guidance</a>.</p><div class="nearby"><strong>Compare nearby rates:</strong> {nearby.map(n=><a href={`/${rateSlug(n)}/`}>${n} an hour annually</a>)}</div><h2>What if you work part-time?</h2><p>Not everyone works 40 hours every week. Compare different schedules at the same hourly rate:</p><div class="tablewrap"><table><thead><tr><th>Hours per week</th><th>Monthly average</th><th>Annual gross</th></tr></thead><tbody>{schedules.map(s=><tr><td>{s.hours} hours</td><td>{money(s.monthly)}</td><td>{money(s.annual)}</td></tr>)}</tbody></table></div><h2>How unpaid time off changes your income</h2><p>If you are not paid during time off, 50 working weeks instead of 52 means <strong>{money(rate*40*50)}</strong> annually. If your vacation is paid, keep those weeks in the calculation. The calculator above lets you adjust this assumption directly.</p><h2>How many paid weeks do you work?</h2><p>For hourly workers without paid time off, fewer paid weeks reduce annual income. The table assumes 40 paid hours per week and no overtime.</p><div class="tablewrap"><table><thead><tr><th>Paid weeks / year</th><th>Annual gross pay</th><th>Difference vs. 52 weeks</th></tr></thead><tbody>{paidWeekOptions.map(s=><tr><td>{s.weeks} weeks</td><td>{money(s.annual)}</td><td>{s.lost===0?'—':`−${money(s.lost)}`}</td></tr>)}</tbody></table></div></section><section class="content" id="questions"><h2>Frequently asked questions</h2><p>For a standard full-time schedule, annual hours are 40 × 52 = 2,080. This assumes paid weeks and excludes overtime, bonuses, and benefits. If you take two unpaid weeks, use 50 paid weeks instead.</p>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}<div class="related"><h2>Compare hourly wages</h2><a href="/average-hourly-wage-by-country/">Average hourly wage by country: official data and methods →</a><h2>Explore more hourly rates</h2>{FEATURED_RATES.filter(n=>n!==rate).map(n=><a href={`/${n}-an-hour-is-how-much-a-year/`}>${n} an hour is how much a year? →</a>)}<a href="/">Try the full multi-currency calculator →</a><a href="/salary-to-hourly-calculator/">Convert annual salary to hourly pay →</a><h2>Convert annual salaries to hourly</h2>{SALARIES.map(n=><a href={`/${salarySlug(n)}/`}>{money(n)} a year is how much an hour? →</a>)}</div></section></main><footer><a href="/">Hourly Income Calculator</a><span>Free, private, and calculated in your browser.</span></footer>
<script>
const $=s=>document.querySelector(s),rate=$('#rate'),hours=$('#hours'),weeks=$('#weeks');const format=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(n);const vals=()=>{const r=Math.max(0,Math.min(100000000,Number(rate.value)||0)),h=Math.max(0,Math.min(168,Number(hours.value)||0)),w=Math.max(0,Math.min(52,Number(weeks.value)||0));return {r,h,w,a:r*h*w}};const update=()=>{const {r,h,a}=vals();$('#annual').textContent=format(a);$('#monthly').textContent=format(a/12);$('#biweekly').textContent=format(a/26);$('#weekly').textContent=format(r*h);$('#daily').textContent=format(r*8)};[rate,hours,weeks].forEach(el=>el.addEventListener('input',update));update();
const url=()=>{const u=new URL('/',location.origin);u.searchParams.set('rate',rate.value);u.searchParams.set('hours',hours.value);u.searchParams.set('weeks',weeks.value);u.searchParams.set('currency','USD');return u.href};
$('#share').addEventListener('click',async()=>{const text='My annual gross pay: '+$('#annual').textContent+' — calculate yours!';try{if(navigator.share)await navigator.share({title:'My hourly income',text,url:url()});else if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(text+' '+url());$('#status').textContent='Link copied!'}else $('#status').textContent='Share link: '+url()}catch(e){if(e.name!=='AbortError')$('#status').textContent='Sharing unavailable.'}});
$('#save').addEventListener('click',()=>{const c=document.createElement('canvas');c.width=1080;c.height=1350;const x=c.getContext('2d');if(!x)return;const {r,h,w,a}=vals();x.fillStyle='#f5c928';x.fillRect(0,0,1080,1350);x.fillStyle='#fff';x.fillRect(55,55,970,1240);const t=(s,y,size,color='#30270d')=>{x.fillStyle=color;x.font='bold '+size+'px system-ui';x.fillText(s,105,y)};t('hourlyincome.',165,48);t('EVERY HOUR COUNTS',260,28,'#746020');t('My annual income',355,55,'#30270d');let size=98;x.font='bold '+size+'px system-ui';while(x.measureText(format(a)).width>855&&size>40){size-=2;x.font='bold '+size+'px system-ui'}t(format(a),510,size);t(format(r)+' per hour',585,43);t(h+' hours/week · '+w+' weeks/year',665,28,'#746020');t('Monthly: '+format(a/12),815,42);t('Biweekly: '+format(a/26),910,42);t('Weekly: '+format(r*h),1005,42);t('Before taxes and deductions',1130,27,'#746020');t('hourlyincomecalculator.com',1230,33);c.toBlob(blob=>{if(!blob)return;const u=URL.createObjectURL(blob),link=document.createElement('a');link.href=u;link.download='hourly-income.png';link.click();setTimeout(()=>URL.revokeObjectURL(u),1000)},'image/png')});
</script></body></html>
<style is:global>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap');*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f5c928;color:#30270d;font:15px 'DM Sans',sans-serif}a{color:#30270d}header{max-width:1120px;margin:auto;padding:20px 25px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edcf68}header nav{display:flex;gap:26px;font-size:13px}header .logo{font:800 22px Manrope,sans-serif;color:#30270d;text-decoration:none;letter-spacing:-1px}header .logo span{color:#604714}.breadcrumb{max-width:1050px;margin:23px auto;color:#746020;font-size:12px;padding:0 20px}.hero{text-align:center;padding:12px 20px 40px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.8px;color:#604714}.hero h1{font:800 clamp(30px,4.4vw,56px)/1.15 Manrope,sans-serif;letter-spacing:-2px;margin:15px auto;max-width:900px}.hero h1 em{font-style:normal;color:#604714}.intro{max-width:690px;margin:0 auto 25px;color:#604714;line-height:1.65}.intro strong{color:#30270d}.workspace{display:grid;grid-template-columns:1fr 1fr;max-width:920px;margin:auto;text-align:left;background:#fff;border:1px solid #edcf68;border-radius:20px;overflow:hidden;box-shadow:0 16px 45px #68532b12}.inputs,.output{padding:30px}.inputs label{display:block;font-weight:700;font-size:12px;margin:21px 0 8px}.inputs input{width:100%;height:59px;border:1px solid #ba8c20;border-radius:10px;padding:12px 15px;font:700 25px Manrope,sans-serif;color:#30270d;background:#fefdfb}.two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.two input{height:48px;font-size:17px}.helper{font-size:11px;color:#746020;line-height:1.5}.actions{display:flex;gap:9px;margin-top:22px}.actions button{flex:1;border:1px solid #ba8c20;border-radius:9px;padding:13px 8px;background:#fff;color:#30270d;font-weight:700;cursor:pointer}.actions button:first-child{background:#30270d;color:#fff}.actions button:focus-visible{outline:3px solid #746020}#status{font-size:11px;color:#604714;min-height:1em}.output{background:linear-gradient(140deg,#edcf68,#edcf68)}#annual{display:block;font:800 clamp(39px,4vw,57px) Manrope,sans-serif;letter-spacing:-2px;color:#30270d;margin:14px 0}.bill{height:114px;width:225px;border:5px double #604714;border-radius:10px;background:#ba8c20;margin:17px auto 25px;transform:rotate(-7deg);display:flex;justify-content:space-around;align-items:center;color:#604714;font:800 20px Georgia,serif;box-shadow:9px 9px 0 #ba8c20,17px 16px 0 #ba8c20}.bill b{border:4px double #604714;border-radius:50%;width:67px;height:67px;display:grid;place-items:center;font-size:40px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:18px;border-top:1px solid #ba8c20;padding-top:21px}.stats>div{display:flex;flex-direction:column;gap:6px}.stats small{color:#746020}.stats strong{font:800 20px Manrope,sans-serif;color:#604714}.content{max-width:920px;margin:65px auto;padding:0 22px}.content h2{font:800 clamp(23px,3vw,32px) Manrope,sans-serif;letter-spacing:-1px;margin:36px 0 13px}.content p{line-height:1.8;color:#604714}.tablewrap{overflow-x:auto;max-width:100%;border-radius:12px}.tablewrap table{min-width:580px}.tax-note{font-size:13px}.nearby{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:25px 0}.nearby a{padding:8px 12px;background:#fff;border:1px solid #ba8c20;border-radius:9px;text-decoration:none;font-size:13px;font-weight:700}table{width:100%;border-collapse:collapse;text-align:left;background:#fff;border-radius:12px;overflow:hidden}td,th{padding:16px;border-bottom:1px solid #edcf68}th{background:#edcf68;color:#604714}td:last-child{font-weight:700;color:#30270d}details{border-bottom:1px solid #edcf68;padding:17px 0}summary{cursor:pointer;font-weight:700}.related{display:flex;flex-direction:column;gap:15px}.related h2{margin-bottom:0}footer{max-width:1100px;margin:80px auto 0;padding:30px 22px;border-top:1px solid #edcf68;display:flex;justify-content:space-between;font-size:12px;color:#746020}@media(max-width:680px){header nav{display:none}.hero{padding:10px 12px}.hero h1{letter-spacing:-1.3px}.workspace{grid-template-columns:1fr}.inputs,.output{padding:22px}.bill{height:90px;width:190px;margin:14px auto 23px}.content{margin:35px auto}.stats strong{font-size:17px}footer{flex-direction:column;gap:12px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style>
<style is:global>body{background:#f5c928}.hero{background:radial-gradient(ellipse at 50% 20%,#ffe977,#f9d23c 48%,#edb914)}.logo span,.hero h1 em{color:#aa7400}.result,.output{background:linear-gradient(135deg,#ffe878,#ffd747 50%,#f3bf13)}button{background:linear-gradient(115deg,#fff1a1,#ffda24 35%,#ffeb76 50%,#efb900 80%,#ffd953);color:#473200;border-color:#ce9800}.workspace{border-color:#e9c954}th{background:#fff2b5}header,footer{border-color:#b98b2250}nav,.subtitle,.under,footer,.intro,.hero>p,.content p,.steps p,.faq p,.steps span{color:#30270d}.guide .kicker,.eyebrow{color:#604100}.form-panel,.inputs,.form{background:#fff}.formula{background:#ffe16a}.formula p{color:#30270d}.seo-links a{background:#fff}.links a{background:#ffe16a}.cash-table:before{color:#70520b}

header .language-control select{background:#fff;border-color:#d7ad2f;color:#49370c}.presets button{color:#604714;border-color:#edcf68}.suffix,.hint,.helper,.cash-heading>span,.cash-visual figcaption,.share-feedback,#status{color:#604714}.steps article,.faq details,details,.stats,.grid,td,th{border-color:#bc902d66}.cash-band{background:#ffdf62ed;border-color:#bb890d;color:#49370c}.cash-piece.is-balance{border-color:#b58400;color:#604714;background:#fff}.cash-table.is-empty:after{color:#604714}#cash-sound{background:#fff;border-color:#d7ad2f;color:#604714}#cash-sound:before{background:#b58a22}.actions button,.actions button:first-child,.actions button+button{background:linear-gradient(115deg,#fff1a1,#ffda24 35%,#ffeb76 50%,#efb900 80%,#ffd953);color:#473200;border:1px solid #ce9800}.banknote,.bill{background:#ffe16a;color:#805500;border-color:#ba8900;box-shadow:9px 10px 0 #e6b823,17px 17px 0 #ffdf62}.banknote b,.bill b{border-color:#ba8900}.coin{background:linear-gradient(135deg,#fff2a1,#ffda24,#e8aa00);border-color:#ba8900;color:#805500}.content p,.guide p,.grid small,.stats small{color:#604714}input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #805500;outline-offset:3px}
</style>
