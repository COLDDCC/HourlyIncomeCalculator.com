ible{outline:3px solid #d1ad59}#status{font-size:11px;color:#28764a;min-height:1em}.output{background:linear-gradient(140deg,#eef8ed,#e8f3e4)}#annual{display:block;font:800 clamp(39px,4vw,57px) Manrope,sans-serif;letter-spacing:-2px;color:#205e3c;margin:14px 0}.bill{height:114px;width:225px;border:5px double #5c9264;border-radius:10px;background:#c9e1b8;margin:17px auto 25px;transform:rotate(-7deg);display:flex;justify-content:space-around;align-items:center;color:#4a7e52;font:800 20px Georgia,serif;box-shadow:9px 9px 0 #accf9d,17px 16px 0 #d7e9cd}.bill b{border:4px double #5c9264;border-radius:50%;width:67px;height:67px;display:grid;place-items:center;font-size:40px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:18px;border-top:1px solid #d0e2ce;padding-top:21px}.stats>div{display:flex;flex-direction:column;gap:6px}.stats small{color:#7e9d83}.stats strong{font:800 20px Manrope,sans-serif;color:#2c6443}.content{max-width:920px;margin:65px auto;padding:0 22px}.content h2{font:800 clamp(23px,3vw,32px) Manrope,sans-serif;letter-spacing:-1px;margin:36px 0 13px}.content p{line-height:1.8;color:#65766a}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;background:#fff;border-radius:12px;overflow:hidden}td,th{padding:16px;border-bottom:1px solid #e5ede4}th{background:#edf5ec;color:#386b4b}td:last-child{font-weight:700;color:#225c3d}details{border-bottom:1px solid #dfe9dd;padding:17px 0}summary{cursor:pointer;font-weight:700}.related{display:flex;flex-direction:column;gap:15px}.related h2{margin-bottom:0}footer{max-width:1100px;margin:80px auto 0;padding:30px 22px;border-top:1px solid #e4ece2;display:flex;justify-content:space-between;font-size:12px;color:#849287}@media(max-width:680px){header nav{display:none}.hero{padding:10px 12px}.hero h1{letter-spacing:-1.3px}.workspace{grid-template-columns:1fr}.inputs,.output{padding:22px}.bill{height:90px;width:190px;margin:14px auto 23px}.content{margin:35px auto}.stats strong{font-size:17px}footer{flex-direction:column;gap:12px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style>