---
import { estimateFederalTax } from '../lib/us-federal-tax.js';
const canonical='https://hourlyincomecalculator.com/us-federal-take-home-pay-calculator/';
const sample=estimateFederalTax(20*40*52);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f5c928"/><title>2026 Federal Take-Home Pay Calculator | Hourly Income Calculator</title><meta name="description" content="Estimate 2026 federal income tax, employee Social Security and Medicare from hourly wages. Includes optional overtime for eligible employees."/><link rel="canonical" href={canonical}/><link rel="icon" href="/gold-coin.svg" type="image/svg+xml"/></head>
<body><header><a class="brand" href="/">← Hourly Income Calculator</a><span>2026 · US federal estimate</span></header><main><section class="hero"><p class="eyebrow">FREE PAYCHECK PLANNING TOOL</p><h1>How much do you keep <em>after federal income tax?</em></h1><p>Estimate 2026 federal income and employee payroll taxes from an hourly wage. No sign-up. Your inputs stay in your browser.</p><div class="workspace"><div class="inputs"><label>Hourly pay ($)<input id="rate" type="number" min="0" max="1000000" step=".25" value="20"/></label><div class="two"><label>Hours per week<input id="hours" type="number" min="0" max="168" value="40"/></label><label>Paid weeks per year<input id="weeks" type="number" min="0" max="52" value="52"/></label></div><label>Apply 1.5× overtime after 40 hours <input id="overtime" type="checkbox"/></label><label>Federal filing status<select id="status"><option value="single">Single</option><option value="married_joint">Married filing jointly</option><option value="head_household">Head of household</option><option value="married_separate">Married filing separately</option></select></label><p class="note">Assumes standard deduction and W-2 wages. Optional 1.5× overtime is for eligible non-exempt employees. State taxes and other deductions are excluded.</p></div><div class="results"><span class="eyebrow">AFTER ESTIMATED FEDERAL INCOME AND PAYROLL TAXES</span><output id="net">$35,606</output><dl><div><dt>Annual gross wages</dt><dd id="gross"></dd></div><div><dt>Standard deduction</dt><dd id="deduction"></dd></div><div><dt>Federal taxable income</dt><dd id="taxable"></dd></div><div><dt>Estimated federal income tax</dt><dd id="tax"></dd></div><div><dt>Social Security</dt><dd id="ss"></dd></div><div><dt>Medicare</dt><dd id="medicare"></dd></div><div><dt>Additional Medicare</dt><dd id="additional"></dd></div><div><dt>Monthly after estimated federal taxes</dt><dd id="monthly"></dd></div></dl></div></div></section><section class="content"><h2>What is included in this estimate?</h2><p>This tool applies the 2026 federal income tax brackets and standard deduction, plus employee Social Security (6.2% up to $184,500), Medicare (1.45%) and applicable Additional Medicare Tax (0.9%). The brackets are progressive: only income within each bracket is taxed at that bracket's rate.</p><h2>What is not included?</h2><p><strong>Important:</strong> The result is NOT your actual paycheck or complete take-home pay. It includes employee Social Security and Medicare but does not subtract state or local taxes, insurance, retirement contributions, or other payroll deductions. It also does not model tax credits, itemized deductions, special overtime or tip deductions, or additional taxes. Self-employed workers need a different calculation.</p><h2>Example: $20 an hour in 2026</h2><p>At 40 hours a week for 52 weeks, gross wages are $41,600. A single filer using the $16,100 standard deduction has $25,500 of taxable income before any other adjustments. Federal income tax is calculated progressively, not by taxing all $41,600 at one flat rate.</p><h2>Official source and methodology</h2><p>Payroll tax rules: <a href="https://www.irs.gov/publications/p15">IRS Publication 15 (2026)</a>. Overtime: <a href="https://www.dol.gov/agencies/whd/overtime">US Department of Labor</a>. Federal rates and standard deductions: <a href="https://www.irs.gov/irb/2025-45_IRB">IRS Revenue Procedure 2025-32</a>. Tax year: 2026. Calculations are illustrative and may not reflect your tax return or payroll withholding.</p><p><a href="/">← Back to the multi-currency hourly calculator</a></p></section></main>
<script>
import { FEDERAL_2026, estimateFederalTax, estimateEmployeeFica, estimateWeeklyOvertime } from '../lib/us-federal-tax.js';
const ids=['rate','hours','weeks','status','overtime'];const el=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(n);
function update(){const rate=Math.max(0,Math.min(1000000,Number(el('rate').value)||0)),hours=Math.max(0,Math.min(168,Number(el('hours').value)||0)),weeks=Math.max(0,Math.min(52,Number(el('weeks').value)||0)),status=el('status').value;const ot=estimateWeeklyOvertime(rate,hours);const gross=(el('overtime').checked?ot.weeklyGross:rate*hours)*weeks;const result=estimateFederalTax(gross,status);const fica=estimateEmployeeFica(gross,status);el('gross').textContent=money(result.gross);el('deduction').textContent=money(FEDERAL_2026[status].deduction);el('taxable').textContent=money(result.taxable);el('tax').textContent=money(result.federalTax);el('ss').textContent=money(fica.socialSecurity);el('medicare').textContent=money(fica.medicare);el('additional').textContent=money(fica.additionalMedicare);el('net').textContent=money(result.afterFederal-fica.total);el('monthly').textContent=money((result.afterFederal-fica.total)/12)}
ids.forEach(id=>el(id).addEventListener('input',update));update();
</script>
<style> *{box-sizing:border-box}body{margin:0;background:#fffaf0;color:#30270d;font:16px system-ui,sans-serif}a{color:#604714}header{display:flex;justify-content:space-between;align-items:center;gap:15px;max-width:1100px;margin:auto;padding:23px 20px;border-bottom:1px solid #e8d9aa;font-size:13px}.brand{font-weight:800;text-decoration:none;font-size:17px}.hero{background:linear-gradient(160deg,#fff3ba,#f5c928);text-align:center;padding:48px 16px 60px}.eyebrow{font-size:11px;font-weight:800;letter-spacing:1.3px}.hero h1{font-size:clamp(32px,5vw,55px);letter-spacing:-2px;max-width:850px;margin:12px auto}.hero em{font-style:normal;color:#70500c}.hero>p{max-width:650px;margin:12px auto 26px;line-height:1.6}.workspace{display:grid;grid-template-columns:1fr 1fr;text-align:left;max-width:950px;margin:auto;background:#fffdf7;border-radius:20px;overflow:hidden;box-shadow:0 20px 50px #4d3b1620}.inputs,.results{padding:30px}.inputs label{display:block;font-weight:700;font-size:13px;margin-bottom:17px}.inputs input,.inputs select{display:block;width:100%;padding:13px;margin-top:7px;border:1px solid #c9a64c;border-radius:9px;background:#fff;font-size:19px;color:#30270d}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.note{font-size:12px;line-height:1.6;color:#6e541a}.results{background:#f6d454}#net{display:block;font-size:clamp(32px,4vw,50px);font-weight:850;margin:16px 0 28px;overflow-wrap:anywhere}dl{margin:0}dl div{display:flex;justify-content:space-between;gap:14px;border-top:1px solid #d1aa43;padding:12px 0}dt{font-size:13px}dd{margin:0;font-weight:800;text-align:right}.content{max-width:850px;margin:auto;padding:55px 22px 85px;line-height:1.8}.content h2{margin-top:36px;line-height:1.25}input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #604714;outline-offset:3px}@media(max-width:650px){.workspace{grid-template-columns:1fr}.inputs,.results{padding:22px}.two{grid-template-columns:1fr}header span{display:none}.hero{padding-top:30px}}</style></body></html>