---
const title="Hourly Income Calculator | Hourly to Annual Salary";
const description="Convert hourly pay to annual, monthly, weekly and daily earnings. See your money in USD, EUR, GBP, JPY, AUD, CAD or CHF.";
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#fafbf8"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href="https://hourlyincomecalculator.com/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication",name:"Hourly Income Calculator",applicationCategory:"FinanceApplication",operatingSystem:"Any",url:"https://hourlyincomecalculator.com/",offers:{"@type":"Offer",price:"0",priceCurrency:"USD"}})}></script></head><body>
<header><a class="logo" href="/"><span class="mark">$</span>hourly<span class="green">income</span><span class="gold">.</span></a><nav><a href="#calculator">Calculator</a><a href="#guide">How it works</a><a href="#faq">FAQ</a></nav><a class="nav-cta" href="#calculator">Start calculating ↗</a></header>
<main><section class="hero" id="calculator"><div class="eyebrow"><i></i> THE MONEY YOU MAKE, MADE CLEAR</div><h1>Every hour counts.<br/><em>See what it's worth.</em></h1><p class="subtitle">From your hourly wage to your yearly income. One simple calculator, a clearer view of your money.</p>
<div class="calculator"><div class="form-panel"><div class="panel-top"><div><div class="kicker">YOUR EARNINGS</div><h2>Let's do the math<span class="gold">.</span></h2></div><span class="chip">✦ 100% free</span></div><label for="hourly">Your hourly rate</label><div class="rate"><span id="symbol">$</span><input id="hourly" type="number" min="0" step=".5" value="30"/><span class="suffix">/ hour</span></div><div class="presets"><button data-rate="15">$15</button><button data-rate="20">$20</button><button data-rate="25">$25</button><button data-rate="30" class="selected">$30</button><button data-rate="50">$50</button></div><div class="two"><label>Hours per week<input id="hours" type="number" min="0" max="168" value="40"/></label><label>Weeks per year<input id="weeks" type="number" min="0" max="52" value="52"/></label></div><label for="currency">Your currency</label><select id="currency"><option value="USD">🇺🇸 USD — US Dollar</option><option value="GBP">🇬🇧 GBP — British Pound</option><option value="EUR">🇪🇺 EUR — Euro</option><option value="JPY">🇯🇵 JPY — Japanese Yen</option><option value="AUD">🇦🇺 AUD — Australian Dollar</option><option value="CAD">🇨🇦 CAD — Canadian Dollar</option><option value="CHF">🇨🇭 CHF — Swiss Franc</option></select><p class="hint">Currency selection changes units, not exchange rates. Enter the hourly rate in your selected currency.</p></div>
<div class="result-panel"><div class="result-header"><div class="kicker">YOUR ANNUAL EARNINGS</div><span class="tax-tag">BEFORE TAX</span></div><output id="annual">$62,400</output><p class="muted">That's your hard work, adding up.</p><div class="money-art" aria-hidden="true"><div class="note back"></div><div class="note middle"></div><div class="note front"><span id="denom">100</span><b id="note-symbol">$</b><span id="denom2">100</span></div><div class="coin c1">$</div><div class="coin c2">$</div><div class="coin c3">$</div><span class="shine">✧</span></div><div class="totals"><div><small>Monthly</small><strong id="monthly">$5,200</strong></div><div><small>Biweekly</small><strong id="biweekly">$2,400</strong></div><div><small>Weekly</small><strong id="weekly">$1,200</strong></div><div><small>Daily (8h)</small><strong id="daily">$240</strong></div></div><p class="hint">◎ Gross pay estimate, before taxes or deductions.</p></div></div><p class="under">No signup. No spreadsheets. Just a better understanding of your pay. ↓</p></section>
<section class="guide" id="guide"><div class="kicker">SIMPLE BY DESIGN</div><h2>Know your numbers.<br/><em>Keep your perspective.</em></h2><div class="steps"><article><span>01 /</span><h3>Enter your hourly pay</h3><p>Set your hourly rate, work hours per week and number of paid working weeks.</p></article><article><span>02 /</span><h3>See the whole year</h3><p>Multiply hourly pay by weekly hours and working weeks to estimate annual gross earnings.</p></article><article><span>03 /</span><h3>Make it tangible</h3><p>Compare monthly, biweekly, weekly and daily pay alongside a playful cash illustration.</p></article></div><div class="formula"><div class="kicker">THE FORMULA</div><strong>Hourly rate × hours per week × weeks per year = annual pay</strong><p>$30 × 40 × 52 = $62,400 before tax.</p></div></section>
<section class="guide faq" id="faq"><div class="kicker">GOOD TO KNOW</div><h2>A few common questions<span class="gold">.</span></h2><details open><summary>How much is $30 an hour annually?</summary><p>At 40 hours a week for 52 weeks, $30/hour equals $62,400 annually before tax.</p></details><details><summary>How much is $20 an hour annually?</summary><p>At 40 hours a week for 52 weeks, $20/hour equals $41,600 annually before tax.</p></details><details><summary>Does the calculator estimate take-home pay?</summary><p>Not yet. All results are gross pay, excluding income taxes, payroll contributions and other deductions. Country-specific tax calculators will be added after their rules are verified.</p></details><details><summary>Does changing the currency perform a currency conversion?</summary><p>No. Choose the currency in which you are paid and enter your corresponding hourly wage. This does not use foreign exchange rates.</p></details></section></main><footer><span>© {new Date().getFullYear()} Hourly Income Calculator</span><span>Make every hour count.</span></footer>
<script>
const $=s=>document.querySelector(s);const hourly=$('#hourly'),hours=$('#hours'),weeks=$('#weeks'),currency=$('#currency');const symbols={USD:'$',GBP:'£',EUR:'€',JPY:'¥',AUD:'A$',CAD:'C$',CHF:'CHF'};const denoms={USD:'100',GBP:'50',EUR:'100',JPY:'10000',AUD:'100',CAD:'100',CHF:'100'};const buttons=[...document.querySelectorAll('[data-rate]')];function update(){let rate=Math.max(0,Number(hourly.value)||0),h=Math.max(0,Math.min(168,Number(hours.value)||0)),w=Math.max(0,Math.min(52,Number(weeks.value)||0)),a=rate*h*w,c=currency.value;const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:c,maximumFractionDigits:c==='JPY'?0:2}).format(n);$('#annual').textContent=money(a);$('#monthly').textContent=money(a/12);$('#biweekly').textContent=money(a/26);$('#weekly').textContent=money(rate*h);$('#daily').textContent=money(rate*8);$('#symbol').textContent=symbols[c];$('#note-symbol').textContent=symbols[c];$('#denom').textContent=denoms[c];$('#denom2').textContent=denoms[c];document.querySelectorAll('.coin').forEach(el=>el.textContent=symbols[c]);buttons.forEach(b=>{b.textContent=symbols[c]+b.dataset.rate;b.classList.toggle('selected',Number(b.dataset.rate)===rate)})}buttons.forEach(b=>b.addEventListener('click',()=>{hourly.value=b.dataset.rate;update()}));[hourly,hours,weeks,currency].forEach(e=>e.addEventListener('input',update));update();
</script></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');:root{font-family:'DM Sans',sans-serif;background:#fafbf8;color:#1b3024}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button,input,select{font:inherit}header{height:76px;max-width:1210px;margin:auto;padding:0 30px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ecf0e9}.logo{font-family:Manrope,sans-serif;font-weight:800;font-size:20px;letter-spacing:-1.2px;display:flex;align-items:center}.mark{display:inline-grid;place-items:center;width:32px;height:32px;border:1.5px solid #258055;border-radius:9px;font-size:21px;color:#24744f;margin-right:9px}.green{color:#45946c}.gold{color:#ccab58}nav{display:flex;gap:35px;color:#79877b;font-size:13px}.nav-cta{font-size:12px;background:#176344;color:#fff;border-radius:30px;padding:13px 18px}.hero{text-align:center;padding:65px 18px 25px;background:radial-gradient(ellipse at 50% 70%,#eaf5e6 0%,transparent 58%)}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:#4d9065;border:1px solid #e0eddf;background:#eff7ed;border-radius:30px;padding:8px 15px;font-size:10px;font-weight:800;letter-spacing:1.6px}.eyebrow i{width:6px;height:6px;border-radius:50%;background:#57ab74}.hero h1,.guide h2{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-3.5px;line-height:1.12}.hero h1{font-size:clamp(37px,5vw,65px);margin:19px 0 14px}.hero em,.guide em{font-style:normal;color:#429466}.subtitle{color:#859387;font-size:14px;line-height:1.7;margin:0 auto 31px;max-width:520px}.calculator{max-width:980px;margin:auto;display:grid;grid-template-columns:1fr 1fr;text-align:left;background:white;border:1px solid #e3eade;box-shadow:0 22px 60px #285d4012;border-radius:21px;overflow:hidden}.form-panel{padding:31px 37px}.panel-top,.result-header{display:flex;justify-content:space-between;align-items:start}.kicker{color:#528b65;font-size:10px;font-weight:800;letter-spacing:1.8px}.form-panel h2{font-family:Manrope,sans-serif;font-size:22px;letter-spacing:-1px;margin:7px 0 25px}.chip{border-radius:25px;background:#f2f8ef;color:#77a16c;padding:8px 12px;font-size:10px;font-weight:700}.form-panel label{font-size:12px;font-weight:700;display:block;margin-bottom:10px}.rate{height:76px;border:1.5px solid #b8dabe;background:#fcfffb;border-radius:11px;display:flex;align-items:center;padding:0 16px}.rate>span:first-child{font-size:29px;font-weight:700;color:#398762}.rate input{width:100%;min-width:0;background:none;border:none;outline:none;font-family:Manrope,sans-serif;font-size:37px;font-weight:800;color:#25432f;padding:0 9px;letter-spacing:-2px}.suffix{font-size:12px;color:#9da99c;white-space:nowrap}.presets{display:flex;gap:8px;margin:12px 0 23px}.presets button{flex:1;padding:8px 3px;background:#fff;border:1px solid #e8eee7;border-radius:7px;font-size:11px;color:#718173;cursor:pointer}.presets button.selected{background:#e9f5e9;border-color:#bedcc3;color:#237449;font-weight:700}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}.two input,select{display:block;width:100%;height:44px;border:1px solid #e4ece3;border-radius:8px;padding:0 12px;margin-top:9px;background:white;color:#34503d;font-size:13px}select{margin-top:0;cursor:pointer}.hint{font-size:10px;color:#95a99a;line-height:1.6;margin:10px 0 0}.result-panel{background:linear-gradient(145deg,#f0f8ec,#edf6e8);padding:33px 37px 21px;overflow:hidden}.tax-tag{font-size:9px;font-weight:800;color:#6e9c73;background:#ddf0d9;border-radius:5px;padding:7px 9px;letter-spacing:1px}#annual{display:block;font-family:Manrope,sans-serif;color:#245b3d;font-size:clamp(39px,4vw,56px);font-weight:800;letter-spacing:-3px;margin:13px 0 0;white-space:nowrap}.muted{font-size:12px;color:#7e9982;margin:0}.money-art{position:relative;height:176px;margin-top:15px}.note{position:absolute;left:50%;top:36px;width:215px;height:105px;border:3px solid #629569;border-radius:8px;transform:translateX(-57%) rotate(-8deg);background:repeating-linear-gradient(35deg,transparent 0 12px,#74a47a20 12px 13px),#cbe2ba;box-shadow:0 8px 14px #397e441c;display:flex;align-items:center;justify-content:space-around;color:#407c55;font-family:Georgia,serif;font-size:16px;font-weight:bold}.note:after{content:'';position:absolute;inset:9px;border:2px solid #70a67766;border-radius:4px}.note b{height:59px;width:59px;display:grid;place-items:center;border:3px double #4d865c;border-radius:50%;font-size:34px}.note.back{transform:translateX(-50%) rotate(8deg);top:27px;background:#d7eacb}.note.middle{transform:translateX(-54%) rotate(1deg);top:32px;background:#c1dcae}.note.front{z-index:1}.coin{position:absolute;width:51px;height:51px;display:grid;place-items:center;border:5px double #d7a64a;background:linear-gradient(135deg,#ffeab0,#edbd52);color:#ad7c25;border-radius:50%;box-shadow:2px 5px 0 #c69a45,0 11px 15px #9f762536;font-family:Georgia,serif;font-size:21px;font-weight:800;z-index:2}.c1{left:calc(50% + 83px);top:104px}.c2{left:calc(50% + 103px);top:80px;transform:scale(.8)}.c3{left:calc(50% + 72px);top:59px;transform:scale(.65)}.shine{position:absolute;right:65px;top:4px;color:#deb95b;font-size:31px}.totals{display:grid;grid-template-columns:1fr 1fr;gap:18px 8px;border-top:1px solid #d6e7d5;padding-top:19px}.totals>div{display:flex;flex-direction:column;gap:4px}.totals small{font-size:11px;color:#86a08a}.totals strong{font:800 20px Manrope,sans-serif;letter-spacing:-.6px;color:#305d40}.under{font-size:12px;color:#9ba99b;margin:21px 0}.guide{max-width:1050px;padding:94px 25px 10px;margin:auto}.guide h2{font-size:clamp(31px,4vw,44px);margin:14px 0 36px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.steps article{border-top:1px solid #dfe9dc;padding:25px 4px}.steps span{font-size:12px;color:#9aaf9c}.steps h3{font:800 17px Manrope,sans-serif;margin-top:32px}.steps p,.formula p,.faq p{font-size:13px;color:#829083;line-height:1.8}.formula{background:#eef5ed;border-radius:14px;padding:30px;margin-top:20px}.formula strong{display:block;margin:14px 0;font:700 18px Manrope,sans-serif}.formula p{margin:0}.faq{padding-bottom:110px}.faq details{padding:20px 0;border-bottom:1px solid #e1e9e0}.faq summary{font-weight:700;cursor:pointer}.faq p{max-width:750px}footer{border-top:1px solid #e6ede4;max-width:1210px;padding:27px 30px;margin:auto;display:flex;justify-content:space-between;color:#93a096;font-size:11px}@media(max-width:760px){header{padding:0 17px;height:65px}nav{display:none}.logo{font-size:16px}.mark{width:27px;height:27px;font-size:18px}.nav-cta{font-size:10px;padding:11px}.hero{padding:33px 12px}.hero h1{letter-spacing:-2px;margin:15px 0 12px}.subtitle{font-size:12px;margin-bottom:19px}.calculator{grid-template-columns:1fr;border-radius:15px}.form-panel,.result-panel{padding:23px 21px}.form-panel h2{margin-bottom:16px}.rate{height:64px}.rate input{font-size:31px}.presets{margin-bottom:17px}.two{margin-bottom:17px}.result-panel{padding-top:21px}#annual{font-size:43px}.money-art{height:133px;transform:scale(.83);transform-origin:center center;margin:-8px 0}.totals{gap:10px;padding-top:14px}.totals strong{font-size:18px}.guide{padding-top:67px}.steps{grid-template-columns:1fr;gap:0}.steps article{padding:17px 3px}.steps h3{margin-top:12px}.faq{padding-bottom:70px}}@media(max-width:380px){#annual{font-size:35px}.hero h1{font-size:33px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
</style>