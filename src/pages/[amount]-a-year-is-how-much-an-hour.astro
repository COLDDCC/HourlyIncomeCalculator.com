---
import BrandLogo from '../components/BrandLogo.astro';
import { SALARIES, salarySlug, HOURLY_RATES } from '../lib/salary-pages.js';
export function getStaticPaths(){return SALARIES.map(salary=>({params:{amount:String(salary)},props:{salary}}))}
const {salary}=Astro.props;
const rates=HOURLY_RATES;
const hourly=salary/2080,monthly=salary/12,biweekly=salary/26,semimonthly=salary/24,weekly=salary/52,daily=weekly/5;
const usd0=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const usd2=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',minimumFractionDigits:2,maximumFractionDigits:2}).format(n);
const short=salary%1000===0?`${salary/1000}k`:usd0(salary);
const title=`${usd0(salary)} a Year Is How Much an Hour? ${usd2(hourly)}/hr`;
const description=`${usd0(salary)} a year is ${usd2(hourly)} an hour at 40 hours a week. See monthly, biweekly and weekly pay, your rate at 45–50 hour weeks, and calculate your own schedule.`;
const canonical=`https://hourlyincomecalculator.com/${salarySlug(salary)}/`;
const schedules=[35,37.5,40,45,50,55].map(h=>({hours:h,rate:salary/(h*52)}));
// Typical US full-time benefits: 10 vacation days + 11 holidays = 21 paid days off (168 hours).
const workedHours=2080-21*8,effective=salary/workedHours;
const quick=salary/2000;
const nearest=rates.reduce((a,b)=>Math.abs(b-hourly)<Math.abs(a-hourly)?b:a);
const others=SALARIES.filter(n=>n!==salary);
const faq=[
 {q:`How much is ${usd0(salary)} a year per hour?`,a:`${usd0(salary)} a year is ${usd2(hourly)} per hour before taxes, based on 40 hours a week and 52 paid weeks (2,080 hours).`},
 {q:`How much is ${short} a year per month?`,a:`${usd0(salary)} a year is ${usd2(monthly)} per month on average before taxes, or ${usd2(biweekly)} per biweekly paycheck (26 pay periods).`},
 {q:`What is ${usd0(salary)} a year at 50 hours a week?`,a:`If you regularly work 50 hours a week without overtime pay, ${usd0(salary)} works out to ${usd2(salary/(50*52))} per hour.`},
 {q:'Does this include taxes?',a:'No. All figures are gross pay. Your take-home pay depends on federal, state and local taxes, payroll taxes, retirement contributions and benefits deductions.'}
];
---
<!doctype html><html lang="en"><head><meta name="theme-color" content="#f5c928"/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/gold-coin.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(x=>({"@type":"Question",name:x.q,acceptedAnswer:{"@type":"Answer",text:x.a}}))})}></script></head>
<body><header><BrandLogo /><nav><a href="/salary-to-hourly-calculator/">Salary calculator</a><a href="#breakdown">Pay breakdown</a><a href="#questions">FAQ</a></nav></header><main><div class="breadcrumb"><a href="/">Hourly Income Calculator</a> / <a href="/salary-to-hourly-calculator/">Salary to hourly</a> / {usd0(salary)} a year</div><section class="hero"><div class="eyebrow">ANNUAL SALARY TO HOURLY</div><h1>How much is <em>{usd0(salary)} a year</em> an hour?</h1><p class="intro">At 40 hours a week for 52 paid weeks, {usd0(salary)} a year is <strong>{usd2(hourly)} an hour before taxes.</strong> Change the hours below to see your real hourly rate.</p>
<div class="workspace"><div class="inputs"><div class="eyebrow">CALCULATE YOUR HOURLY RATE</div><label for="salary">Annual salary ($)</label><input id="salary" type="number" min="0" max="1000000000" step="100" value={salary}/><div class="two"><div><label for="hours">Hours / week</label><input id="hours" type="number" min="1" max="168" value="40"/></div><div><label for="weeks">Paid weeks / year</label><input id="weeks" type="number" min="1" max="52" value="52"/></div></div><p class="helper">Results update as you type. All amounts are before tax.</p><p class="helper"><a href={`/salary-to-hourly-calculator/?salary=${salary}&hours=40&weeks=52&currency=USD`}>Use other currencies in the full salary calculator →</a></p></div><div class="output"><div class="eyebrow">YOUR HOURLY PAY · BEFORE TAX</div><output id="hourly">{usd2(hourly)}</output><div class="bill" aria-hidden="true"><span>100</span><b>$</b><span>100</span></div><div class="stats"><div><small>Monthly</small><strong id="monthly">{usd0(monthly)}</strong></div><div><small>Biweekly</small><strong id="biweekly">{usd0(biweekly)}</strong></div><div><small>Weekly</small><strong id="weekly">{usd0(weekly)}</strong></div><div><small>Daily (8h)</small><strong id="daily">{usd0(hourly*8)}</strong></div></div></div></div></section>
<section class="content" id="breakdown"><h2>{usd0(salary)} a year: full pay breakdown</h2><p>A standard full-time year has 40 × 52 = 2,080 paid hours. Your hourly rate is calculated as <strong>{usd0(salary)} ÷ 2,080 = {usd2(hourly)}</strong>.</p><div class="tablewrap"><table><thead><tr><th>Pay period</th><th>Gross pay</th></tr></thead><tbody><tr><td>Hour</td><td>{usd2(hourly)}</td></tr><tr><td>8-hour workday</td><td>{usd2(hourly*8)}</td></tr><tr><td>Week</td><td>{usd2(weekly)}</td></tr><tr><td>Every two weeks (26 paychecks)</td><td>{usd2(biweekly)}</td></tr><tr><td>Twice a month (24 paychecks)</td><td>{usd2(semimonthly)}</td></tr><tr><td>Month</td><td>{usd2(monthly)}</td></tr><tr><td>Year</td><td>{usd0(salary)}</td></tr></tbody></table></div>
<h2>Quick mental math</h2><p>Divide the salary by 2,000 — or simply halve the number of thousands — for a fast estimate: {usd0(salary)} ÷ 2,000 ≈ <strong>{usd2(quick)}</strong> an hour. The exact figure at 2,080 hours is slightly lower, {usd2(hourly)}.</p>
<h2>Your real hourly rate if you work longer weeks</h2><p>Salaried employees are often paid the same amount no matter how many hours they work. If your job regularly runs past 40 hours, your effective hourly pay falls:</p><div class="tablewrap"><table><thead><tr><th>Hours per week</th><th>Effective hourly rate</th></tr></thead><tbody>{schedules.map(s=><tr><td>{s.hours} hours</td><td>{usd2(s.rate)}</td></tr>)}</tbody></table></div>
<h2>Counting paid time off</h2><p>Your salary also pays you for vacation and public holidays. With 10 vacation days and 11 holidays — a common US full-time package — you work about {workedHours.toLocaleString('en-US')} hours a year, so each hour actually worked earns about <strong>{usd2(effective)}</strong>. Use this number when comparing a salaried offer with an hourly job that has no paid time off.</p>
<h2>What about take-home pay?</h2><p>These are gross figures. Federal income tax, Social Security, Medicare, state and local taxes and benefit deductions reduce what reaches your bank account. <a href="/us-federal-take-home-pay-calculator/">Estimate your US federal take-home pay →</a></p></section>
<section class="content" id="questions"><h2>Frequently asked questions</h2>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}<div class="related"><h2>Compare with hourly pay</h2><a href={`/${nearest}-an-hour-is-how-much-a-year/`}>${nearest} an hour is how much a year? →</a><a href="/average-hourly-wage-by-country/">Average hourly wage by country →</a><h2>More annual salaries</h2>{others.map(n=><a href={`/${salarySlug(n)}/`}>{usd0(n)} a year is how much an hour? →</a>)}<a href="/salary-to-hourly-calculator/">Convert any salary to hourly pay →</a></div></section></main><footer><a href="/">Hourly Income Calculator</a><span>Free, private, and calculated in your browser.</span></footer>
<script>
const $=s=>document.querySelector(s),salary=$('#salary'),hours=$('#hours'),weeks=$('#weeks');const f2=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',minimumFractionDigits:2,maximumFractionDigits:2}).format(n);const f0=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);const update=()=>{const s=Math.max(0,Math.min(1e9,Number(salary.value)||0)),h=Math.max(0,Math.min(168,Number(hours.value)||0)),w=Math.max(0,Math.min(52,Number(weeks.value)||0)),r=h*w>0?s/(h*w):0;$('#hourly').textContent=f2(r);$('#monthly').textContent=f0(s/12);$('#biweekly').textContent=f0(s/26);$('#weekly').textContent=f0(w>0?s/w:0);$('#daily').textContent=f0(r*8)};[salary,hours,weeks].forEach(el=>el.addEventListener('input',update));update();
</script></body></html>
<style is:global>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap');*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f5c928;color:#30270d;font:15px 'DM Sans',sans-serif}a{color:#30270d}header{max-width:1120px;margin:auto;padding:20px 25px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edcf68}header nav{display:flex;gap:26px;font-size:13px}header .logo{font:800 22px Manrope,sans-serif;color:#30270d;text-decoration:none;letter-spacing:-1px}header .logo span{color:#604714}.breadcrumb{max-width:1050px;margin:23px auto;color:#746020;font-size:12px;padding:0 20px}.hero{text-align:center;padding:12px 20px 40px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.8px;color:#604714}.hero h1{font:800 clamp(30px,4.4vw,56px)/1.15 Manrope,sans-serif;letter-spacing:-2px;margin:15px auto;max-width:900px}.hero h1 em{font-style:normal;color:#604714}.intro{max-width:690px;margin:0 auto 25px;color:#604714;line-height:1.65}.intro strong{color:#30270d}.workspace{display:grid;grid-template-columns:1fr 1fr;max-width:920px;margin:auto;text-align:left;background:#fff;border:1px solid #edcf68;border-radius:20px;overflow:hidden;box-shadow:0 16px 45px #68532b12}.inputs,.output{padding:30px}.inputs label{display:block;font-weight:700;font-size:12px;margin:21px 0 8px}.inputs input{width:100%;height:59px;border:1px solid #ba8c20;border-radius:10px;padding:12px 15px;font:700 25px Manrope,sans-serif;color:#30270d;background:#fefdfb}.two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.two input{height:48px;font-size:17px}.helper{font-size:11px;color:#746020;line-height:1.5}.actions{display:flex;gap:9px;margin-top:22px}.actions button{flex:1;border:1px solid #ba8c20;border-radius:9px;padding:13px 8px;background:#fff;color:#30270d;font-weight:700;cursor:pointer}.actions button:first-child{background:#30270d;color:#fff}.actions button:focus-visible{outline:3px solid #746020}#status{font-size:11px;color:#604714;min-height:1em}.output{background:linear-gradient(140deg,#edcf68,#edcf68)}#annual{display:block;font:800 clamp(39px,4vw,57px) Manrope,sans-serif;letter-spacing:-2px;color:#30270d;margin:14px 0}.bill{height:114px;width:225px;border:5px double #604714;border-radius:10px;background:#ba8c20;margin:17px auto 25px;transform:rotate(-7deg);display:flex;justify-content:space-around;align-items:center;color:#604714;font:800 20px Georgia,serif;box-shadow:9px 9px 0 #ba8c20,17px 16px 0 #ba8c20}.bill b{border:4px double #604714;border-radius:50%;width:67px;height:67px;display:grid;place-items:center;font-size:40px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:18px;border-top:1px solid #ba8c20;padding-top:21px}.stats>div{display:flex;flex-direction:column;gap:6px}.stats small{color:#746020}.stats strong{font:800 20px Manrope,sans-serif;color:#604714}.content{max-width:920px;margin:65px auto;padding:0 22px}.content h2{font:800 clamp(23px,3vw,32px) Manrope,sans-serif;letter-spacing:-1px;margin:36px 0 13px}.content p{line-height:1.8;color:#604714}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;background:#fff;border-radius:12px;overflow:hidden}td,th{padding:16px;border-bottom:1px solid #edcf68}th{background:#edcf68;color:#604714}td:last-child{font-weight:700;color:#30270d}details{border-bottom:1px solid #edcf68;padding:17px 0}summary{cursor:pointer;font-weight:700}.related{display:flex;flex-direction:column;gap:15px}.related h2{margin-bottom:0}footer{max-width:1100px;margin:80px auto 0;padding:30px 22px;border-top:1px solid #edcf68;display:flex;justify-content:space-between;font-size:12px;color:#746020}@media(max-width:680px){header nav{display:none}.hero{padding:10px 12px}.hero h1{letter-spacing:-1.3px}.workspace{grid-template-columns:1fr}.inputs,.output{padding:22px}.bill{height:90px;width:190px;margin:14px auto 23px}.content{margin:35px auto}.stats strong{font-size:17px}footer{flex-direction:column;gap:12px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style>
<style is:global>body{background:#f5c928}.hero{background:radial-gradient(ellipse at 50% 20%,#ffe977,#f9d23c 48%,#edb914)}.logo span,.hero h1 em{color:#aa7400}.result,.output{background:linear-gradient(135deg,#ffe878,#ffd747 50%,#f3bf13)}button{background:linear-gradient(115deg,#fff1a1,#ffda24 35%,#ffeb76 50%,#efb900 80%,#ffd953);color:#473200;border-color:#ce9800}.workspace{border-color:#e9c954}th{background:#fff2b5}header,footer{border-color:#b98b2250}nav,.subtitle,.under,footer,.intro,.hero>p,.content p,.steps p,.faq p,.steps span{color:#30270d}.guide .kicker,.eyebrow{color:#604100}.form-panel,.inputs,.form{background:#fff}.formula{background:#ffe16a}.formula p{color:#30270d}.seo-links a{background:#fff}.links a{background:#ffe16a}.cash-table:before{color:#70520b}

header .language-control select{background:#fff;border-color:#d7ad2f;color:#49370c}.presets button{color:#604714;border-color:#edcf68}.suffix,.hint,.helper,.cash-heading>span,.cash-visual figcaption,.share-feedback,#status{color:#604714}.steps article,.faq details,details,.stats,.grid,td,th{border-color:#bc902d66}.cash-band{background:#ffdf62ed;border-color:#bb890d;color:#49370c}.cash-piece.is-balance{border-color:#b58400;color:#604714;background:#fff}.cash-table.is-empty:after{color:#604714}#cash-sound{background:#fff;border-color:#d7ad2f;color:#604714}#cash-sound:before{background:#b58a22}.actions button,.actions button:first-child,.actions button+button{background:linear-gradient(115deg,#fff1a1,#ffda24 35%,#ffeb76 50%,#efb900 80%,#ffd953);color:#473200;border:1px solid #ce9800}.banknote,.bill{background:#ffe16a;color:#805500;border-color:#ba8900;box-shadow:9px 10px 0 #e6b823,17px 17px 0 #ffdf62}.banknote b,.bill b{border-color:#ba8900}.coin{background:linear-gradient(135deg,#fff2a1,#ffda24,#e8aa00);border-color:#ba8900;color:#805500}.content p,.guide p,.grid small,.stats small{color:#604714}input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #805500;outline-offset:3px}
</style>
