---
const title='Salary to Hourly Calculator — Convert Annual Pay to Hourly Wage';
const description='Convert annual salary to hourly pay instantly. Adjust your weekly hours and paid weeks to compare monthly, weekly, daily and hourly earnings.';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href="https://hourlyincomecalculator.com/salary-to-hourly-calculator/"/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication",name:"Salary to Hourly Calculator",applicationCategory:"FinanceApplication",operatingSystem:"Any",url:"https://hourlyincomecalculator.com/salary-to-hourly-calculator/",offers:{"@type":"Offer",price:"0",priceCurrency:"USD"}})}></script></head><body><header><a class="logo" href="/">＄ hourly<span>income.</span></a><a href="/">Hourly to salary ↗</a></header><main><section class="hero"><div class="eyebrow">SALARY TO HOURLY CONVERTER</div><h1>Your salary, <em>by the hour.</em></h1><p>Find out what your annual salary really pays per hour. Adjust your working schedule and see the difference instantly.</p><div class="workspace"><div class="form"><label for="salary">Annual gross salary</label><div class="input-group"><span id="symbol">$</span><input id="salary" type="number" min="0" max="1000000000" value="62400" step="100" /></div><div class="two"><div><label for="hours">Hours per week</label><input id="hours" type="number" min="1" max="168" value="40"/></div><div><label for="weeks">Paid weeks per year</label><input id="weeks" type="number" min="1" max="52" value="52"/></div></div><label for="currency">Currency</label><select id="currency"><option value="USD">USD — US Dollar</option><option value="GBP">GBP — British Pound</option><option value="EUR">EUR — Euro</option><option value="JPY">JPY — Japanese Yen</option><option value="AUD">AUD — Australian Dollar</option><option value="CAD">CAD — Canadian Dollar</option><option value="CHF">CHF — Swiss Franc</option></select><p class="hint">Changing currency changes the displayed unit, not the exchange rate. Enter your salary in the selected currency.</p><div class="actions"><button type="button" id="save">↓ Save as image</button><button type="button" id="share">↗ Share result</button></div><p id="status" role="status" aria-live="polite"></p></div><div class="result"><div class="eyebrow">YOUR HOURLY PAY · BEFORE TAX</div><output id="hourly">$30.00</output><div class="illustration" aria-hidden="true"><div class="banknote"><span>100</span><b>$</b><span>100</span></div><div class="coin">✦</div></div><div class="grid"><div><small>Monthly</small><strong id="monthly">$5,200</strong></div><div><small>Biweekly</small><strong id="biweekly">$2,400</strong></div><div><small>Weekly</small><strong id="weekly">$1,200</strong></div><div><small>Daily (8h)</small><strong id="daily">$240</strong></div></div><p class="hint">Gross salary before taxes and other deductions.</p></div></div></section><section class="content"><h2>How to convert salary to hourly pay</h2><p>Divide your annual gross salary by your total paid working hours in the year. For a standard 40-hour week over 52 paid weeks, that means dividing by 2,080.</p><div class="formula"><strong>Annual salary ÷ (weekly hours × paid weeks) = hourly rate</strong><p>For example, $62,400 ÷ (40 × 52) = $30 per hour.</p></div><h2>Common annual salaries converted to hourly rates</h2><table><thead><tr><th>Annual salary</th><th>Hourly rate (40h × 52w)</th></tr></thead><tbody>{[30000,40000,50000,60000,70000,80000,100000].map(s=><tr><td>{new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(s)}</td><td>{new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(s/2080)}</td></tr>)}</tbody></table><h2>Frequently asked questions</h2><details><summary>How much is $60,000 a year hourly?</summary><p>$60,000 divided by 2,080 paid working hours is approximately $28.85 per hour before tax.</p></details><details><summary>Does paid time off affect the hourly calculation?</summary><p>Paid vacation is included in your annual salary. If you take unpaid weeks off, adjust paid weeks to reflect the time you actually earn wages. This calculator shows an equivalent hourly rate, not your contractual pay rate.</p></details><details><summary>Does this calculate take-home pay?</summary><p>No. This tool converts gross salary only. Actual take-home pay depends on taxes, payroll contributions and personal circumstances.</p></details><h2>Explore hourly pay examples</h2><div class="links">{[15,20,25,30,35,40,50,75,100].map(n=><a href={`/${n}-an-hour-is-how-much-a-year/`}>${n} an hour annually →</a>)}</div></section></main><footer>Hourly Income Calculator · <a href="/">Home</a></footer>
<script>
const $=s=>document.querySelector(s);const salary=$('#salary'),hours=$('#hours'),weeks=$('#weeks'),currency=$('#currency');const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:currency.value,maximumFractionDigits:currency.value==='JPY'?0:2}).format(n);const state=()=>{const s=Math.max(0,Math.min(1e9,Number(salary.value)||0)),h=Math.max(0,Math.min(168,Number(hours.value)||0)),w=Math.max(0,Math.min(52,Number(weeks.value)||0));return {s,h,w,rate:h*w>0?s/(h*w):0}};function update(){const {s,h,rate}=state();$('#hourly').textContent=money(rate);$('#monthly').textContent=money(s/12);$('#biweekly').textContent=money(s/26);$('#weekly').textContent=money(rate*h);$('#daily').textContent=money(rate*8);$('#symbol').textContent={USD:'$',GBP:'£',EUR:'€',JPY:'¥',AUD:'A$',CAD:'C$',CHF:'CHF'}[currency.value]}[salary,hours,weeks,currency].forEach(x=>x.addEventListener('input',update));update();
const url=()=>{const u=new URL(location.href);u.search='';u.searchParams.set('salary',salary.value);u.searchParams.set('hours',hours.value);u.searchParams.set('weeks',weeks.value);u.searchParams.set('currency',currency.value);return u.href};const p=new URLSearchParams(location.search);for(const [name,el,max] of [['salary',salary,1e9],['hours',hours,168],['weeks',weeks,52]]){const v=p.get(name);if(v!==null&&Number.isFinite(Number(v))&&Number(v)>=0&&Number(v)<=max)el.value=v}if(['USD','GBP','EUR','JPY','AUD','CAD','CHF'].includes(p.get('currency')))currency.value=p.get('currency');update();
$('#share').addEventListener('click',async()=>{const text='My annual salary works out to '+$('#hourly').textContent+' per hour before tax.';try{if(navigator.share)await navigator.share({title:'My hourly income',text,url:url()});else if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(text+' '+url());$('#status').textContent='Link copied!'}else $('#status').textContent=url()}catch(e){if(e.name!=='AbortError')$('#status').textContent='Sharing unavailable.'}});
$('#save').addEventListener('click',()=>{const canvas=document.createElement('canvas');canvas.width=1080;canvas.height=1350;const x=canvas.getContext('2d');if(!x)return;const {s,h,w,rate}=state();x.fillStyle='#faf8f5';x.fillRect(0,0,1080,1350);x.fillStyle='#fff';x.fillRect(55,55,970,1240);const text=(t,y,size,color='#5c4823')=>{x.fillStyle=color;x.font='bold '+size+'px system-ui';x.fillText(t,105,y)};text('hourlyincome.',165,49);text('SALARY TO HOURLY',275,31,'#9b907d');text('My hourly earnings',370,53);let size=100;x.font='bold '+size+'px system-ui';while(x.measureText(money(rate)).width>860&&size>36){size-=2;x.font='bold '+size+'px system-ui'}text(money(rate),540,size);text('Annual salary: '+money(s),650,39);text(h+' hours/week · '+w+' paid weeks/year',750,29,'#948975');text('Monthly: '+money(s/12),885,39);text('Weekly: '+money(rate*h),975,39);text('Before tax and deductions',1115,29,'#978c78');text('hourlyincomecalculator.com',1240,31);canvas.toBlob(blob=>{if(!blob)return;const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='salary-to-hourly.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)},'image/png')});
</script></body></html>
<style is:global>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Manrope:wght@500;700;800&display=swap');*{box-sizing:border-box}body{margin:0;background:#fbfaf8;color:#3a3120;font:15px 'DM Sans',sans-serif}a{color:#735724}header{max-width:1100px;margin:auto;padding:23px;display:flex;justify-content:space-between;border-bottom:1px solid #edebe6;font-size:13px}.logo{font:800 21px Manrope,sans-serif;text-decoration:none;color:#4e3f23}.logo span{color:#957946}.hero{text-align:center;padding:70px 20px 30px;background:radial-gradient(ellipse at center,#f7f2e8,transparent 70%)}.eyebrow{font-size:11px;color:#8a7754;font-weight:800;letter-spacing:1.5px}.hero h1{font:800 clamp(37px,5vw,64px) Manrope,sans-serif;letter-spacing:-3px;margin:18px 0}.hero h1 em{font-style:normal;color:#957842}.hero>p{color:#948e84;max-width:580px;margin:0 auto 35px;line-height:1.6}.workspace{display:grid;grid-template-columns:1fr 1fr;max-width:960px;margin:auto;background:#fff;border:1px solid #e9e4dc;border-radius:19px;overflow:hidden;text-align:left;box-shadow:0 18px 50px #5b492714}.form,.result{padding:35px}.form label{display:block;font-size:12px;font-weight:700;margin:21px 0 9px}.input-group{display:flex;align-items:center;border:1px solid #d9ceb9;border-radius:10px;padding:0 15px}.input-group span{font-size:29px;color:#806532}.input-group input{border:0;flex:1;min-width:0}.form input,.form select{height:56px;width:100%;padding:10px 13px;font:700 21px Manrope,sans-serif;color:#5e4b28;background:white;border:1px solid #e8e4dc;border-radius:9px}.input-group input{border:0}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.two input{font-size:16px}.form select{font:500 14px 'DM Sans',sans-serif}.hint{color:#999182;font-size:11px;line-height:1.6}.actions{display:flex;gap:10px;margin-top:20px}.actions button{flex:1;padding:12px 5px;background:#6c5221;color:#fff;border:0;border-radius:9px;font-weight:700;cursor:pointer}.actions button+button{background:#f4f0e9;color:#675024}#status{font-size:12px;color:#795f2e}.result{background:linear-gradient(145deg,#f8f4ec,#f4eee4)}#hourly{display:block;font:800 clamp(39px,4vw,60px) Manrope,sans-serif;color:#5e4923;letter-spacing:-2px;margin:15px 0}.illustration{height:185px;display:grid;place-items:center;position:relative}.banknote{width:215px;height:105px;background:#e3d4b8;border:5px double #98835b;border-radius:9px;display:flex;align-items:center;justify-content:space-around;transform:rotate(-8deg);box-shadow:9px 10px 0 #d2c3a6,17px 17px 0 #e9e0cf;font:800 20px Georgia,serif;color:#826e49}.banknote b{border:4px double #98835b;border-radius:50%;height:66px;width:66px;display:grid;place-items:center;font-size:42px}.coin{position:absolute;right:24%;bottom:13px;border-radius:50%;background:#f1c969;border:5px double #d0a447;width:56px;height:56px;display:grid;place-items:center;color:#b48a30;font-size:25px}.grid{border-top:1px solid #e6dfd3;padding-top:20px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.grid>div{display:flex;flex-direction:column;gap:5px}.grid small{color:#9c9381}.grid strong{font:800 20px Manrope,sans-serif;color:#614e2b}.content{max-width:900px;margin:65px auto;padding:0 24px}.content h2{font:800 30px Manrope,sans-serif;letter-spacing:-1px;margin-top:43px}.content p{color:#827c71;line-height:1.8}.formula{padding:28px;border-radius:12px;background:#f6f2eb}.formula strong{font-size:18px}.formula p{margin-bottom:0}table{width:100%;border-collapse:collapse;background:#fff}td,th{border-bottom:1px solid #e9e5df;text-align:left;padding:15px}th{background:#f5f2ec}details{border-bottom:1px solid #e9e5df;padding:17px 0}summary{font-weight:700;cursor:pointer}.links{display:flex;gap:12px;flex-wrap:wrap}.links a{background:#f5f1ea;border-radius:25px;padding:10px 15px;text-decoration:none;font-size:13px}footer{padding:40px 24px;border-top:1px solid #e9e5df;text-align:center;font-size:12px;color:#979187}@media(max-width:720px){.hero{padding:35px 12px}.hero h1{letter-spacing:-1.5px}.workspace{grid-template-columns:1fr}.form,.result{padding:23px}.content{margin:35px auto}.grid strong{font-size:17px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}</style>
<style is:global>body{background:#fffefa}.hero{background:radial-gradient(ellipse at center,#fff0a0,transparent 70%)}.logo span,.hero h1 em{color:#aa7400}.result,.output{background:linear-gradient(135deg,#fffdf0,#fff1a4 50%,#ffe37a)}button{background:linear-gradient(115deg,#fff1a1,#ffda24 35%,#ffeb76 50%,#efb900 80%,#ffd953);color:#473200;border-color:#ce9800}.workspace{border-color:#e9c954}th{background:#fff2b5}</style>
