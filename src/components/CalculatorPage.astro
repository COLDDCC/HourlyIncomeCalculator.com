---
import { MARKETS, languageCurrency } from '../lib/market.js';
import BrandLogo from './BrandLogo.astro';
import { LANGUAGES, languagePath, translator } from '../lib/i18n.js';
const { lang = 'en' } = Astro.props;
const t=translator(lang);
const title=t('title'),description=t('description');
const defaultCurrency=languageCurrency(lang);
const defaultRate=MARKETS[defaultCurrency].rate;
const locale=lang==='zh-Hant'?'zh-Hant-HK':lang;
const money=n=>new Intl.NumberFormat(locale,{style:'currency',currency:defaultCurrency,maximumFractionDigits:defaultCurrency==='JPY'?0:2}).format(n);
const canonical='https://hourlyincomecalculator.com'+languagePath(lang);
const currencyNames={CNY:'CNY — 人民币',USD:'USD — US Dollar',GBP:'GBP — Pound Sterling',EUR:'EUR — Euro',JPY:'JPY — 日本円',AUD:'AUD — Australian Dollar',CAD:'CAD — Canadian Dollar',CHF:'CHF — Swiss Franc',HKD:'HKD — 港幣',MOP:'MOP — 澳門幣'};
---
<!doctype html><html lang={lang==='zh'?'zh-Hans':lang}><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f5c928"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/gold-coin.svg" type="image/svg+xml"/>
{Object.keys(LANGUAGES).map(code=><link rel="alternate" hreflang={code==='zh'?'zh-Hans':code} href={'https://hourlyincomecalculator.com'+languagePath(code)}/>)}
<link rel="alternate" hreflang="x-default" href="https://hourlyincomecalculator.com/"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:title,inLanguage:lang,applicationCategory:'FinanceApplication',operatingSystem:'Any',url:canonical,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}})}></script>
</head><body data-language={lang}>
<header><div class="header-brand"><BrandLogo href={languagePath(lang)} /><div class="header-intro"><h1 class="header-subtitle">{t('subtitle')}</h1></div></div><nav><a href="#calculator">{t('calculator')}</a><a href="#guide">{t('guide')}</a><a href="#faq">{t('faq')}</a></nav><label class="language-control"><span class="sr-only">{t('language')}</span><select id="language">{Object.entries(LANGUAGES).map(([code,name])=><option value={code} selected={code===lang}>{name}</option>)}</select></label></header>
<main><section class="hero" id="calculator">
<div class="calculator"><div class="form-panel">
<label for="hourly">{t('rate')}</label><div class="rate"><span id="symbol">{({CNY:'¥',USD:'$',GBP:'£',EUR:'€',JPY:'¥',AUD:'A$',CAD:'C$',CHF:'CHF',HKD:'HK$',MOP:'MOP$'})[defaultCurrency]}</span><input id="hourly" type="number" min="0" max="100000000" step=".01" value={defaultRate}/><span class="suffix">{t('perHour')}</span></div>
<div class="presets">{MARKETS[defaultCurrency].presets.map(rate=><button type="button" data-rate={rate}>{money(rate)}</button>)}</div>
<div class="two"><label>{t('hours')}<input id="hours" type="number" min="0" max="168" value="40"/></label><label>{t('weeks')}<input id="weeks" type="number" min="0" max="52" value="52"/></label></div>
<label for="currency">{t('currency')}</label><select id="currency">{Object.entries(currencyNames).map(([code,name])=><option value={code} selected={code===defaultCurrency}>{code+' — '+new Intl.DisplayNames([locale],{type:'currency'}).of(code)}</option>)}</select><p class="hint">{t('currencyHint')}</p></div>
<div class="result-panel"><div class="result-header"><div class="kicker">{t('annualLabel')}</div><span class="tax-tag">{t('beforeTax')}</span></div><output id="annual">{money(defaultRate*40*52)}</output>
<div class="totals">{[['monthly','monthlyLabel'],['biweekly','biweeklyLabel'],['weekly','weeklyLabel'],['daily','dailyLabel']].map(([id,key])=><div><small>{t(key)}</small><strong id={id}>{money(({monthly:defaultRate*40*52/12,biweekly:defaultRate*40*2,weekly:defaultRate*40,daily:defaultRate*8})[id])}</strong></div>)}</div><figure class="cash-visual" id="cash-visual"><div class="cash-toolbar"><label for="cash-period">{t('cash')}</label><select id="cash-period">{['hourly','daily','weekly','monthly','annual'].map(period=><option value={period} selected={period==='daily'}>{t(period)}</option>)}</select></div>
<div class="cash-heading"><strong id="cash-total">{money(defaultRate*8)}</strong><span id="cash-pieces"></span><button id="cash-sound" type="button" aria-pressed="false" title={t('soundHint')}>{t('soundOff')}</button></div>
<div class="cash-table" id="cash-table" role="group" aria-label={t('tableLabel')} data-mark={t('tableMark')}></div><div class="cash-controls"><div class="cash-layout-controls"><button id="cash-spread" type="button" aria-pressed="true">{t('spread')}</button><button id="cash-arrange" type="button" aria-pressed="false">{t('tidy')}</button></div><button id="cash-change" type="button">{t('change')}</button></div><figcaption id="cash-caption" role="status" aria-live="polite"></figcaption></figure>
<p class="hint">{t('grossHint')}</p><div class="share-actions"><button id="save-image" type="button">{t('save')}</button><button id="share-result" type="button" aria-expanded="false" aria-controls="social-share-options">{t('share')}</button></div><div id="social-share-options" class="social-share-options" hidden aria-label="Share your result"><button type="button" class="social-button social-instagram" data-social="instagram" aria-label="Share on Instagram" title="Instagram"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v15/icons/instagram.svg" alt="" width="17" height="17" loading="lazy"/><span>Instagram</span></button><button type="button" class="social-button social-facebook" data-social="facebook" aria-label="Share on Facebook" title="Facebook"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v15/icons/facebook.svg" alt="" width="17" height="17" loading="lazy"/><span>Facebook</span></button><button type="button" class="social-button social-reddit" data-social="reddit" aria-label="Share on Reddit" title="Reddit"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v15/icons/reddit.svg" alt="" width="17" height="17" loading="lazy"/><span>Reddit</span></button><button type="button" class="social-button social-x" data-social="x" aria-label="Share on X" title="X"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v15/icons/x.svg" alt="" width="17" height="17" loading="lazy"/><span>X</span></button><button type="button" class="social-button social-whatsapp" data-social="whatsapp" aria-label="Share on WhatsApp" title="WhatsApp"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v15/icons/whatsapp.svg" alt="" width="17" height="17" loading="lazy"/><span>WhatsApp</span></button></div><p id="share-feedback" class="share-feedback" role="status" aria-live="polite"></p></div></div><p class="under">{t('noSignup')}</p></section>
<aside class="research-link" aria-label={t('rankingTitle')}><div><h2>{t('rankingTitle')}</h2><p>{t('rankingDescription')}</p></div><a href={(lang==='zh'?'/zh':'')+'/average-hourly-wage-by-country/'} hreflang={lang==='zh'?'zh-Hans':'en'}>{t('rankingLink')}</a></aside>
<section class="guide" id="guide"><h2>{t('understand')}</h2><div class="steps">{['step1','step2','step3'].map((key,index)=><article><span>{index+1}.</span><p>{t(key)}</p></article>)}</div><div class="formula"><strong>{t('formula')}</strong><p>{t('example')}</p></div></section>
<section class="guide faq" id="faq"><h2>{t('questions')}</h2>{[1,2,3].map((n)=><details open={n===1}><summary>{t('q'+n)}</summary><p>{t('a'+n)}</p></details>)}</section>
<section class="guide related"><h2>{t('guides')}</h2><div class="seo-links">{[15,20,25,30,35,40,50,75,100].map(rate=><a href={`/${rate}-an-hour-is-how-much-a-year/`} hreflang="en">{t('rateGuide',{rate:'$'+rate})} ↗</a>)}<a href="/salary-to-hourly-calculator/" hreflang="en">{t('reverse')} ↗</a><a href="/us-federal-take-home-pay-calculator/" hreflang="en">{t('takeHomeGuide')} ↗</a></div></section>
</main><footer><span>© {new Date().getFullYear()} Hourly Income Calculator</span></footer>
<script>import '../lib/calculator.js';</script>











<style is:global>

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');:root{font-family:'DM Sans',sans-serif;background:#f5c928;color:#30270d}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button,input,select{font:inherit}header{height:76px;max-width:1210px;margin:auto;padding:0 30px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edcf68}.logo{font-family:Manrope,sans-serif;font-weight:800;font-size:20px;letter-spacing:-1.2px;display:flex;align-items:center}.mark{display:inline-grid;place-items:center;width:32px;height:32px;border:1.5px solid #604714;border-radius:9px;font-size:21px;color:#604714;margin-right:9px}.green{color:#604714}.gold{color:#746020}nav{display:flex;gap:35px;color:#746020;font-size:13px}.nav-cta{font-size:12px;background:#634817;color:#fff;border-radius:30px;padding:13px 18px}.hero{text-align:center;padding:65px 18px 25px;background:radial-gradient(ellipse at 50% 70%,#edcf68 0%,transparent 58%)}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:#604714;border:1px solid #edcf68;background:#edcf68;border-radius:30px;padding:8px 15px;font-size:10px;font-weight:800;letter-spacing:1.6px}.eyebrow i{width:6px;height:6px;border-radius:50%;background:#746020}.hero h1,.guide h2{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-3.5px;line-height:1.12}.hero h1{font-size:clamp(37px,5vw,65px);margin:19px 0 14px}.hero em,.guide em{font-style:normal;color:#604714}.subtitle{color:#746020;font-size:14px;line-height:1.7;margin:0 auto 31px;max-width:520px}.calculator{max-width:980px;margin:auto;display:grid;grid-template-columns:1fr 1fr;text-align:left;background:white;border:1px solid #edcf68;box-shadow:0 22px 60px #5d4a2812;border-radius:21px;overflow:hidden}.form-panel{padding:31px 37px}.panel-top,.result-header{display:flex;justify-content:space-between;align-items:start}.kicker{color:#604714;font-size:10px;font-weight:800;letter-spacing:1.8px}.form-panel h2{font-family:Manrope,sans-serif;font-size:22px;letter-spacing:-1px;margin:7px 0 25px}.chip{border-radius:25px;background:#edcf68;color:#746020;padding:8px 12px;font-size:10px;font-weight:700}.form-panel label{font-size:12px;font-weight:700;display:block;margin-bottom:10px}.rate{height:76px;border:1.5px solid #ba8c20;background:#fffefb;border-radius:11px;display:flex;align-items:center;padding:0 16px}.rate>span:first-child{font-size:29px;font-weight:700;color:#604714}.rate input{width:100%;min-width:0;background:none;border:none;outline:none;font-family:Manrope,sans-serif;font-size:37px;font-weight:800;color:#30270d;padding:0 9px;letter-spacing:-2px}.suffix{font-size:12px;color:#746020;white-space:nowrap}.presets{display:flex;gap:8px;margin:12px 0 23px}.presets button{flex:1;padding:8px 3px;background:#fff;border:1px solid #edcf68;border-radius:7px;font-size:11px;color:#604714;cursor:pointer}.presets button.selected{background:#edcf68;border-color:#ba8c20;color:#604714;font-weight:700}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}.two input,select{display:block;width:100%;height:44px;border:1px solid #edcf68;border-radius:8px;padding:0 12px;margin-top:9px;background:white;color:#30270d;font-size:13px}select{margin-top:0;cursor:pointer}.hint{font-size:10px;color:#746020;line-height:1.6;margin:10px 0 0}.result-panel{background:linear-gradient(145deg,#edcf68,#edcf68);padding:33px 37px 21px;overflow:hidden}.tax-tag{font-size:9px;font-weight:800;color:#746020;background:#edcf68;border-radius:5px;padding:7px 9px;letter-spacing:1px}#annual{display:block;font-family:Manrope,sans-serif;color:#30270d;font-size:clamp(39px,4vw,56px);font-weight:800;letter-spacing:-3px;margin:13px 0 0;white-space:nowrap}.muted{font-size:12px;color:#746020;margin:0}.totals{display:grid;grid-template-columns:1fr 1fr;gap:18px 8px;border-top:1px solid #ba8c20;padding-top:19px}.totals>div{display:flex;flex-direction:column;gap:4px}.totals small{font-size:11px;color:#746020}.totals strong{font:800 20px Manrope,sans-serif;letter-spacing:-.6px;color:#30270d}.under{font-size:12px;color:#746020;margin:21px 0}.guide{max-width:1050px;padding:94px 25px 10px;margin:auto}.guide h2{font-size:clamp(31px,4vw,44px);margin:14px 0 36px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.steps article{border-top:1px solid #edcf68;padding:25px 4px}.steps span{font-size:12px;color:#746020}.steps h3{font:800 17px Manrope,sans-serif;margin-top:32px}.steps p,.formula p,.faq p{font-size:13px;color:#746020;line-height:1.8}.formula{background:#edcf68;border-radius:14px;padding:30px;margin-top:20px}.formula strong{display:block;margin:14px 0;font:700 18px Manrope,sans-serif}.formula p{margin:0}.faq{padding-bottom:110px}.faq details{padding:20px 0;border-bottom:1px solid #edcf68}.faq summary{font-weight:700;cursor:pointer}.faq p{max-width:750px}footer{border-top:1px solid #edcf68;max-width:1210px;padding:27px 30px;margin:auto;display:flex;justify-content:space-between;color:#746020;font-size:11px}@media(max-width:760px){header{padding:0 17px;height:65px}nav{display:none}.logo{font-size:16px}.mark{width:27px;height:27px;font-size:18px}.nav-cta{font-size:10px;padding:11px}.hero{padding:33px 12px}.hero h1{letter-spacing:-2px;margin:15px 0 12px}.subtitle{font-size:12px;margin-bottom:19px}.calculator{grid-template-columns:1fr;border-radius:15px}.form-panel,.result-panel{padding:23px 21px}.form-panel h2{margin-bottom:16px}.rate{height:64px}.rate input{font-size:31px}.presets{margin-bottom:17px}.two{margin-bottom:17px}.result-panel{padding-top:21px}#annual{font-size:43px}.money-art{height:133px;transform:scale(.83);transform-origin:center center;margin:-8px 0}.totals{gap:10px;padding-top:14px}.totals strong{font-size:18px}.guide{padding-top:67px}.steps{grid-template-columns:1fr;gap:0}.steps article{padding:17px 3px}.steps h3{margin-top:12px}.faq{padding-bottom:70px}}@media(max-width:380px){#annual{font-size:35px}.hero h1{font-size:33px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
.share-actions{display:flex;gap:10px;margin-top:17px}.share-actions button{flex:1;border-radius:9px;border:1px solid #ba8c20;background:#fff;color:#30270d;font-weight:700;font-size:12px;padding:13px 7px;cursor:pointer}.share-actions button:first-child{background:#30270d;color:#fff;border-color:#30270d}.share-actions button:hover{filter:brightness(.96)}.share-actions button:focus-visible{outline:3px solid #746020;outline-offset:2px}.share-feedback{font-size:11px;color:#604714;min-height:1em;margin:8px 0 0}@media(max-width:380px){.share-actions button{font-size:11px}}.seo-links{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.seo-links a{padding:18px 20px;background:#fff;border:1px solid #edcf68;border-radius:12px;text-decoration:none;color:#604714;font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center}.seo-links a:hover{background:#edcf68}.seo-links span{color:#746020}@media(max-width:600px){.seo-links{grid-template-columns:1fr}.seo-links a{padding:15px}}

/* Real banknote artwork; no currency symbols are painted over the image. */
[hidden]{display:none!important}.hero{padding-top:26px}.hero h1{font-size:clamp(32px,3.4vw,45px);letter-spacing:-2px;margin:12px 0 9px}.hero h1 br{display:none}.hero h1 em{margin-left:.15em}.subtitle{margin-bottom:20px}.form-panel{padding:25px 32px}.result-panel{padding:25px 32px 18px}.form-panel h2{margin-bottom:19px}.cash-visual{margin:8px 0 15px}.cash-visual figcaption{text-align:center;font-size:9px;line-height:1.5;color:#604714}.currency-summary{min-height:175px;display:flex;justify-content:center;flex-direction:column;color:#604714}.currency-summary span{font-weight:700}.currency-summary p{font-size:12px}#annual{font-size:clamp(27px,3.4vw,48px);letter-spacing:-1.8px;overflow-wrap:anywhere;white-space:normal}.hint{color:#604714}.totals small{color:#604714}.subtitle{color:#604714}.share-actions{margin-top:14px}.under{margin-bottom:0}
@media(max-width:760px){.hero{padding-top:20px}.hero h1{font-size:32px}.hero h1 br{display:block}.hero h1 em{margin-left:0}.form-panel,.result-panel{padding:21px}.hero .subtitle{font-size:12px}.currency-summary{min-height:100px}#annual{font-size:clamp(26px,8vw,43px)}}


.cash-visual{margin:16px 0}.cash-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}.cash-toolbar label{font-size:11px;color:#604714;font-weight:700}.cash-toolbar select{width:auto;height:30px;font-size:11px;padding:0 24px 0 9px;border-color:#ba8c20;background:#ffffffa6;margin:0}.cash-heading{display:flex;align-items:baseline;justify-content:space-between;margin:10px 0 9px;gap:12px}.cash-heading strong{font:800 20px Manrope,sans-serif;color:#30270d}.cash-heading>span{font-size:10px;color:#604714}.cash-visual figcaption{margin-top:9px;text-align:left;font-size:9px;line-height:1.5;color:#604714}.cash-toolbar select:focus-visible{outline:2px solid #604714;outline-offset:2px}


.cash-table{height:190px;position:relative;isolation:isolate;overflow:hidden;border:1px solid #ba8c20;border-radius:12px;background:radial-gradient(ellipse at 46% 42%,#edcf68,#edcf68);box-shadow:inset 0 1px 14px #5a4b3010;user-select:none}.cash-table:before{content:'USD · YOUR HARD WORK, IN YOUR HANDS';position:absolute;left:14px;bottom:11px;font-size:8px;letter-spacing:1.2px;color:#746020;pointer-events:none}.cash-table.is-empty:after{content:'Your next dollar starts here.';position:absolute;inset:0;display:grid;place-items:center;font-size:13px;color:#746020;pointer-events:none}.cash-piece{position:absolute;display:block;aspect-ratio:7/3;border:none;border-radius:2px;padding:0;background:none;cursor:grab;touch-action:none;transform:rotate(var(--angle,0deg));transition:left .38s cubic-bezier(.2,.8,.2,1),top .38s cubic-bezier(.2,.8,.2,1),transform .3s;filter:drop-shadow(1px 4px 3px #3e362640);animation:none}.cash-piece img{display:block;width:100%;height:100%;object-fit:fill;border-radius:2px;pointer-events:none}.cash-piece.is-coin{aspect-ratio:1;border-radius:50%;filter:drop-shadow(1px 3px 2px #3e362640)}.cash-piece.is-coin img{border-radius:50%;object-fit:contain}.cash-piece:hover{filter:drop-shadow(2px 6px 4px #3e362655)}.cash-piece:focus-visible{outline:3px solid #746020;outline-offset:4px;z-index:1000!important}.cash-piece.is-dragging{cursor:grabbing;transition:none;transform:rotate(-3deg) scale(1.07);filter:drop-shadow(3px 10px 6px #3e362650)}.cash-band{position:absolute;left:39%;top:0;bottom:0;min-width:24%;padding:0 3px;display:grid;place-items:center;background:#eee3bfdc;border-left:1px solid #746020;border-right:1px solid #746020;color:#30270d;font-size:10px;font-weight:800;pointer-events:none}.is-coin .cash-band{left:0;right:0;top:auto;bottom:-5px;min-width:0;border:1px solid #746020;border-radius:10px;font-size:9px}.cash-controls{display:flex;align-items:center;justify-content:space-between;gap:7px;margin:10px 0 0}.cash-layout-controls{display:flex;gap:3