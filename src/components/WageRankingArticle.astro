---
import BrandLogo from './BrandLogo.astro';
import {wages,sources,checked,hourlyEquivalent,calculatorLink,countryNotes} from '../data/wage-rankings.js';
const {lang='en'}=Astro.props;
const zh=lang==='zh',L=(en,cn)=>zh?cn:en;
const path='/average-hourly-wage-by-country/';
const origin='https://hourlyincomecalculator.com';
const canonical=origin+(zh?'/zh':'')+path;
const title=L('Average Hourly Wage by Country: 2025 Data, 2026 Review','各国时薪排行榜：2025年工资数据与2026年核查');
const description=L('Compare 9 countries using OECD 2025 estimated wages, PPP hourly equivalents and local currencies. Includes China separately, official median pay and source links.','用OECD同口径2025年工资估计比较9国时薪折算值，单列中国数据，附购买力、当地货币、官方时薪中位数、计算方法和原始来源。');
const num=(n,d=2)=>new Intl.NumberFormat(zh?'zh-CN':'en-US',{minimumFractionDigits:d,maximumFractionDigits:d}).format(n);
const ref=id=>sources.findIndex(s=>s.id===id)+1;
const faq=zh?[
 ['哪个国家时薪最高？','在本文比较的九个国家中，按2025年OECD平均年薪估计、购买力平价美元与统一2,080小时折算，瑞士排第一。这不是全球所有国家的排名，也不是实际观测时薪排名。'],
 ['这里的美元是实际美元吗？','除美国本币数值外，排行列使用购买力平价美元（USD PPP），用于比较价格水平调整后的工资。它不是可以在银行兑换的汇率美元。'],
 ['为什么中国没有和其他国家一起排名？','中国国家统计局的城镇私营、非私营单位工资有不同调查范围，不能直接拼接进OECD平均劳动者工资系列。本文列出本币数据与同一假设下的折算，不给出不可比名次。'],
 ['如何把年薪换算成时薪？','用税前年薪除以每周小时数与每年计薪周数的乘积。每周40小时、每年52周对应2,080小时；这只是统一比较假设，不代表各国真实平均工时。'],
 ['平均时薪、中位数和最低工资有什么不同？','平均值是工资总额除以人数，中位数是排序后的中间位置；最低工资是适用规则下的工资下限。三者不能混为一张同口径排行榜。'],
 ['这是2026年全年的工资数据吗？','不是。本文于2026年10月18日核查，主表使用OECD在2026年报告中发布的2025年工资估计，单独标注其他统计的时期。']
]:[
 ['Which country has the highest hourly wage?','Among these nine countries, Switzerland leads the 2025 OECD average-wage comparison in PPP dollars using a common 2,080-hour conversion. This is not a worldwide ranking or an observed hourly-earnings ranking.'],
 ['Are PPP dollars the same as US dollars at an exchange rate?','No. USD PPP adjusts for differences in price levels. It is a comparison unit, not a bank exchange rate or an amount you can transfer abroad. The local-currency column shows the separate domestic wage equivalent.'],
 ['Why is China outside the ranking?','China’s urban private-unit and non-private-unit wage statistics cover different populations from the OECD average-worker series. We show local-currency figures and the same conversion assumption separately rather than assign a misleading comparable rank.'],
 ['How do you convert annual salary to hourly pay?','Divide gross annual pay by weekly hours multiplied by paid weeks. A 40-hour week and 52 paid weeks gives 2,080 hours. This common scenario is not a claim about actual average hours in each country.'],
 ['What is the difference between average, median and minimum wages?','The mean adds wages and divides by the number of workers. The median is the midpoint of the distribution. A minimum wage is the applicable legal wage floor. They answer different questions.'],
 ['Is this full-year 2026 wage data?','No. This article was checked on October 18, 2026. Its main table uses 2025 wage estimates published in OECD Taxing Wages 2026. Other statistics have their own reference periods shown.']
];
const graph={'@context':'https://schema.org','@graph':[
 {'@type':'Article','@id':canonical+'#article',headline:title,description,inLanguage:zh?'zh-Hans':'en',datePublished:checked,dateModified:checked,mainEntityOfPage:canonical,author:{'@type':'Organization',name:'Hourly Income Calculator editorial team',url:origin},publisher:{'@type':'Organization',name:'Hourly Income Calculator',url:origin},citation:sources.map(s=>s.url),about:[{'@type':'Thing',name:'Hourly earnings'},{'@type':'Thing',name:'Purchasing power parity'}]},
 {'@type':'Dataset','@id':canonical+'#dataset',name:L('2025 average wage hourly equivalents: nine-country comparison','2025年平均工资时薪折算：九国比较'),description:L('Derived annual-wage equivalents, not observed hourly earnings. OECD 2025 estimates divided by 2,080 hours; local currency and USD PPP. China excluded from comparable ranking.','OECD 2025年工资估计除以2,080小时；本币及购买力平价美元。属于年薪折算，不是观测时薪；中国不参与可比排名。'),url:canonical+'#ranking',creator:{'@type':'Organization',name:'Hourly Income Calculator'},isBasedOn:sources[0].url,temporalCoverage:'2025',spatialCoverage:wages.map(r=>({'@type':'Country',name:r.en})),variableMeasured:['Gross annual average-worker wage in local currency','Gross annual average-worker wage in USD PPP','Derived hourly equivalent at 2080 hours per year'],distribution:[{'@type':'DataDownload',encodingFormat:'text/csv',contentUrl:origin+'/data/hourly-wage-by-country-2025.csv'}]},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Hourly Income Calculator',item:origin+(zh?'/zh/':'/')},{'@type':'ListItem',position:2,name:title,item:canonical}]},
 {'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
]};
---
<!doctype html><html lang={zh?'zh-Hans':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={origin+path}/><link rel="alternate" hreflang="zh-Hans" href={origin+'/zh'+path}/><link rel="alternate" hreflang="x-default" href={origin+path}/><link rel="icon" href="/gold-coin.svg" type="image/svg+xml"/><meta name="theme-color" content="#f5c928"/><meta property="og:type" content="article"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="article:published_time" content={checked}/><meta property="article:modified_time" content={checked}/><script type="application/ld+json" set:html={JSON.stringify(graph)} /></head>
<body><header><BrandLogo href={zh?'/zh/':'/'}/><nav aria-label={L('Main navigation','主导航')}><a href={zh?'/zh/':'/'}>{L('Calculator','时薪计算器')}</a><a href={(zh?'':'/zh')+path} hreflang={zh?'en':'zh-Hans'}>{zh?'English':'简体中文'}</a></nav></header>
<main><article><div class="meta">{L('WAGE RESEARCH · 10 COUNTRIES COVERED','工资研究 · 覆盖10个国家')} · <time datetime={checked}>{L('Checked October 18, 2026','核查日期：2026年10月18日')}</time></div><h1>{title}</h1>
<p class="answer"><strong>{L('Switzerland ranks first among the nine comparable countries in this guide.','在本文九个可比国家中，瑞士排名第一。')}</strong> {L('The table compares 2025 estimated gross average-worker annual wages in purchasing-power-adjusted dollars, divided by a common 2,080-hour year. China is covered separately. These are hourly equivalents, not measured hourly wages.','主表将2025年税前平均劳动者年薪估计统一按每年2,080小时折算，使用购买力平价美元排序。中国单列。这些数值是时薪折算值，不是实际观测时薪。')} <a href="#source-oecd">[1]</a></p>
<nav class="contents" aria-label={L('On this page','文章目录')}>{[['ranking',L('Ranking','排行榜')],['benchmarks',L('Official hourly pay','官方时薪')],['china',L('China','中国')],['methodology',L('Method','计算方法')],['sources',L('Sources & downloads','来源与下载')]].map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav>
<section id="ranking"><h2>{L('Average hourly wage by country: a comparable benchmark','各国平均时薪：统一口径的折算比较')}</h2><p class="compact">{L('2025 estimates · USD PPP ranking · gross pay · 40 hours × 52 weeks by default. Rank is within this selection, not the world.','2025年估计 · 按购买力平价美元排序 · 税前 · 默认40小时×52周。名次仅限本表，不代表全球排名。')} <a href="#source-oecd">[1]</a></p>
<div class="table-tools"><label for="comparison-hours">{L('Compare at hours/week','比较假设：每周小时数')} <select id="comparison-hours"><option value="40">40</option><option value="37.5">37.5</option><option value="35">35</option></select></label><span id="hours-note" aria-live="polite">2,080 {L('hours/year','小时/年')}</span><a href="/data/hourly-wage-by-country-2025.csv" download>{L('Download CSV','下载CSV')} ↓</a></div>
<div class="table-scroll" tabindex="0" role="region" aria-label={L('Wage comparison table, scroll horizontally for all columns','工资对比表，可横向滚动查看全部列')}><table><caption>{L('OECD 2025 annual wage estimates converted to hourly equivalents','OECD 2025年工资估计的时薪折算')} <span class="assumption">(40 × 52)</span></caption><thead><tr><th scope="col">#</th><th scope="col">{L('Country','国家')}</th><th scope="col">{L('PPP $/hour*','购买力平价美元/小时*')}</th><th scope="col">{L('Local currency/hour*','本币/小时*')}</th><th scope="col">{L('Annual gross · local','税前年薪·本币')}</th><th scope="col">{L('Calculate','计算')}</th></tr></thead><tbody>{wages.map((r,i)=><tr data-annual={r.annual} data-ppp={r.ppp} data-currency={r.currency}><td>{i+1}</td><th scope="row"><a href={'#country-'+r.iso}>{zh?r.zh:r.en}</a></th><td class="ppp">{num(hourlyEquivalent(r.ppp))}</td><td><span class="local">{num(hourlyEquivalent(r.annual))}</span> {r.currency}</td><td>{num(r.annual,0)} {r.currency}</td><td><a class="try" href={calculatorLink(r)} aria-label={L('Open '+r.en+' wage in calculator','用计算器查看'+r.zh+'工资')}>{L('Try →','试算 →')}</a></td></tr>)}</tbody></table></div>
<p class="footnote">{L('* PPP dollars compare price levels; they are not exchange-rate US dollars. Annual ÷ assumed hours is our calculation. The OECD did not publish these as observed hourly rates. Changing the common schedule changes equivalents, not rank.','* 购买力平价美元用于调整价格水平，不是汇率美元。“年薪÷假定工时”为本站计算，并非OECD发布的观测时薪。统一调整工时会改变折算值，不改变排名。')} <a href="#source-ppp">[{ref('ppp')}]</a></p></section>
<section id="benchmarks"><h2>{L('What do official hourly wage statistics say?','官方直接发布的时薪是多少？')}</h2><p>{L('For a personal pay comparison, a direct hourly statistic may be more useful than the table above. Keep its employee population, period and definition attached to the number. These four observations are intentionally not ranked against each other.','判断个人工资时，直接发布的时薪指标往往比上表更有针对性。引用时必须同时保留调查人群、时期与定义。以下四项不相互排名。')}</p>
<div class="benchmarks">{[
 ['USD 33.54 / 24.51',L('United States · May 2025','美国 · 2025年5月'),L('Mean / median hourly wage, all occupations in BLS OEWS.','BLS OEWS全职业平均时薪 / 时薪中位数。'),'bls','US'],
 ['GBP 19.67',L('United Kingdom · April 2025','英国 · 2025年4月'),L('Full-time employee median hourly earnings, excluding overtime.','全职雇员时薪中位数，不含加班。'),'ons','GB'],
 ['AUD 42.90',L('Australia · August 2025','澳大利亚 · 2025年8月'),L('Median hourly earnings in the main job.','主要工作的时薪中位数。'),'abs','AU'],
 ['JPY 1,518',L('Japan · 2025','日本 · 2025年'),L('Mean scheduled hourly wage for short-time workers.','短时间劳动者平均所定内时薪。'),'mhlw','JP']
].map(([value,name,note,id,iso])=><div><h3>{name}</h3><strong>{value}</strong><p>{note} <a href={'#source-'+id}>[{ref(id)}]</a></p></div>)}</div>
<p>{L('Do not sort these figures by their printed numbers: ¥1,518 and £19.67 are different units. Nor should the Japanese short-time mean be presented as equivalent to the British full-time median.','不能按这些数字的大小排序：1,518日元与19.67英镑单位不同；日本短时间劳动者均值与英国全职雇员中位数也不属于同一统计口径。')}</p></section>
<section id="china"><h2>{L('China: annual wages and hourly equivalents in CNY','中国：人民币年薪与时薪折算')}</h2><p>{L('China’s NBS reports two 2025 urban-unit averages: CNY 71,590 for private units and CNY 129,441 for non-private units. At 2,080 assumed hours, these become CNY 34.42 and CNY 62.23 per hour respectively. Neither is a national median or a directly measured hourly wage.','国家统计局公布的2025年城镇私营单位年平均工资为71,590元，非私营单位为129,441元。按假定2,080小时折算，分别约34.42元/小时和62.23元/小时。两者都不是全国工资中位数，也不是直接观测的时薪。')} <a href="#source-nbs">[{ref('nbs')}]</a></p>
<p>{L('The survey covers urban legal entities with five or more employees and excludes self-employed people and freelancers. This population is not interchangeable with the OECD series. Giving China a tenth-place rank would manufacture precision the sources do not support.','调查覆盖城镇地区就业人数5人及以上的法人单位，不包括个体工商户、自由职业者等。它与OECD系列的人群不能直接互换，因此本文不把中国强行排在“第十名”。')} <a href="#source-nbs">[{ref('nbs')}]</a></p><a class="action" href="/zh/?currency=CNY&rate=34.418269&hours=40&weeks=52#calculator">{L('Explore the private-unit example in CNY →','用人民币计算器查看私营单位折算示例 →')}</a></section>
<section id="country-notes"><h2>{L('How to use the numbers in each country','不同国家的数据，应该怎样使用？')}</h2>{countryNotes[lang].map(([name,text,source],index)=><div class="country-note">{[['CH'],['DE','FR','ES'],['GB'],['CA'],['AU'],['US'],['JP']][index].map(iso=><span id={'country-'+iso}></span>)}<h3>{name}</h3><p>{text} <a href={'#source-'+source}>[{ref(source)}]</a></p></div>)}</section>
<section id="methodology"><h2>{L('Methodology: how we built this comparison','方法：这份排行榜如何制作？')}</h2>
<ol><li><strong>{L('Fix the scope.','先确定范围。')}</strong> {L('Eight supported currencies correspond here to ten countries: the US, China, Japan, UK, Australia, Canada, Switzerland, Germany, France and Spain. EUR covers many more countries; this guide selects the three represented by our German, French and Spanish language pages. It is not an exhaustive euro-area or global ranking.','本站八种货币在本文对应十国：美国、中国、日本、英国、澳大利亚、加拿大、瑞士、德国、法国和西班牙。欧元覆盖更多国家，本文选取德、法、西语页面所对应的三个市场，并未穷尽欧元区或全球。')}</li>
<li><strong>{L('Keep the reference year visible.','保留统计年份。')}</strong> {L('The main comparison uses OECD 2025 Secretariat estimates published in Taxing Wages 2026, Tables 1.3 and 1.7. Publication in 2026 does not make these 2026 earnings.','主表采用《Taxing Wages 2026》表1.3和表1.7的2025年OECD秘书处估计。2026年发布不等于2026年工资。')} <a href="#source-oecd">[1]</a></li>
<li><strong>{L('Name the wage concept.','说清工资概念。')}</strong> {L('The OECD average-worker series targets full-time adult gross earnings; coverage has country-specific limitations. It is different from the OECD whole-economy Average Annual Wages indicator. We do not splice those series together.','OECD平均劳动者系列以成年全职劳动者税前工资为对象，国家覆盖存在差异；它不同于OECD全经济体“Average Annual Wages”指标，本文不拼接两个系列。')} <a href="#source-method">[2]</a></li>
<li><strong>{L('Use a common comparison unit.','采用共同单位。')}</strong> {L('Rank by USD PPP annual wages divided by the same annual hours. Local-currency hourly figures are provided for domestic interpretation and calculator inputs, not cross-currency ranking.','用购买力平价美元年薪除以相同年工时排序。本币折算值用于理解当地金额和输入计算器，不用于跨币种直接排名。')} <a href="#source-ppp">[{ref('ppp')}]</a></li>
<li><strong>{L('Show the arithmetic.','展示计算过程。')}</strong> {L('Hourly equivalent = annual gross wage ÷ (hours/week × paid weeks/year). For a purely illustrative 52,000 annual salary: 52,000 ÷ (40 × 52) = 25 per hour; at 35 hours it is 28.57. The same annual salary has different hourly equivalents under different schedules.','时薪折算值=税前年薪÷（每周小时数×每年计薪周数）。例如纯示例年薪52,000：52,000÷（40×52）=25/小时；每周35小时则为28.57。同一年薪在不同工时假设下会有不同折算时薪。')}</li>
<li><strong>{L('Keep annual pay and hours aligned.','让工资与工时相匹配。')}</strong> {L('Do not divide a full-time annual benchmark by part-time hours and call the result a part-time wage. Do not divide employee pay by hours for a broader group that includes the self-employed. For measured hourly earnings, use earnings and hours from a matching source population.','不要把全职年薪除以兼职工时后称为兼职工资，也不要用雇员工资除以包含自雇者的更大人群工时。计算实际小时收入时，工资与工时必须对应同一群体。')} <a href="#source-ilo">[3]</a></li></ol>
<p class="notice">{L('This page calculates standardized equivalents. It does not estimate actual national working hours, take-home pay, occupation-specific wages or a worker’s percentile.','本文计算统一假设下的折算值，不据此估计各国实际工时、税后收入、职业工资或个人收入百分位。')}</p></section>
<section><h2>{L('Mean, median, minimum wage and take-home pay','平均值、中位数、最低工资与到手收入')}</h2><p>{L('Imagine five hourly wages of 10, 12, 15, 18 and 100. Their mean is 31, but the median is 15. A person earning 20 is above the median yet below the mean. “Below average” alone therefore tells you little about where someone stands in the distribution.','假设五人的时薪分别是10、12、15、18和100，均值为31，中位数却是15。时薪20的人高于中位数、低于均值。因此，仅说“低于平均”不足以判断一个人在工资分布中的位置。')}</p><p>{L('Minimum wages answer a legal eligibility question and need a jurisdiction, effective date, age category and employment classification. This article does not provide a current minimum-wage league table. Check the relevant authority before evaluating legal compliance.','最低工资回答的是适用规则下的工资下限，需要地区、生效日期、年龄和用工类别。本文不是现行最低工资排行榜；核对是否合法，应查询适用地区的官方规定。')}</p><p>{L('Gross earnings are before employee deductions. Employer labour cost includes additional employer expenses, while take-home pay depends on your own taxes, deductions and household circumstances. A gross-pay ranking cannot answer “where will I save most?” without a separate budget.','税前工资尚未扣除个人缴费等；雇主用工成本还包含额外雇主支出，到手收入则取决于税费、扣款和家庭情况。若要回答“在哪个国家最能存钱”，还需要另做生活预算。')} <a href="#source-ilo">[3]</a></p></section>
<section><h2>{L('Compare your own hourly pay without misreading the rank','怎样用这份数据判断自己的时薪？')}</h2><ol><li>{L('Choose a benchmark matching your country, occupation, experience and employment type. Start with a median when asking about a typical worker.','先匹配国家、职业、资历和用工类型。想了解“普通劳动者”，优先寻找合适人群的中位数。')}</li><li>{L('Put your gross pay and paid hours on the same basis. Add relevant cash bonuses consistently; compare net pay only with net pay.','将税前收入与计薪工时对应起来，现金奖金采用一致口径；税后只与税后比较。')}</li><li>{L('Use local currency for a domestic offer. For an international move, prepare a city-level budget rather than treating PPP as a personal cost-of-living calculator.','国内报价用本币比较；跨国求职再做城市生活预算，不把购买力平价当成个人生活费计算器。')}</li><li>{L('Use the calculator to change hours and paid weeks. It changes units and scenarios; it does not perform foreign-exchange conversion or locate your wage percentile.','用计算器调整工时和计薪周数。它用于金额与情景试算，不进行汇率换算，也不推断工资百分位。')}</li></ol><a class="action" href={zh?'/zh/#calculator':'/#calculator'}>{L('Calculate your hourly, weekly and annual income →','计算你的时薪、周薪与年收入 →')}</a></section>
<section id="faq"><h2>{L('Frequently asked questions','常见问题')}</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section id="sources"><h2>{L('Sources, data downloads and corrections','原始来源、数据下载与更正')}</h2><p>{L('Research and calculations: Hourly Income Calculator editorial team. Sources checked October 18, 2026. Table values are rounded to two decimals only after calculation. The downloadable snapshot retains source annual figures and the 2,080-hour assumption.','资料整理与计算：Hourly Income Calculator 编辑团队。来源核查于2026年10月18日。先计算，后将表格金额四舍五入至两位小数。下载数据保留原始年薪数值与2,080小时假设。')}</p><p><a href="/data/hourly-wage-by-country-2025.csv" download>{L('CSV: nine-country comparison','CSV：九国对比数据')}</a> · <a href="/data/hourly-wage-by-country-2025.json">{L('JSON: data, definitions and provenance','JSON：数据、定义与来源记录')}</a></p><ol class="sources">{sources.map(s=><li id={'source-'+s.id}><a href={s.url} rel="external">{s.name}</a><p>{s.note}</p></li>)}</ol><h3>{L('Update policy','更新规则')}</h3><p>{L('A replacement release must be checked for reference year, revisions, scope and definition before any value is changed. The snapshot date stays fixed until a real data review occurs. If a source changes, cite the release and table number when reporting a discrepancy through this repository’s issue tracker.','更新任何数字前，需重新核对统计年份、修订、人群范围与定义。只有实际复核数据后才修改核查日期。发现差异时，请通过项目的问题追踪页面提供原始发布、表号与对应数字。')} <a href="https://github.com/COLDDCC/HourlyIncomeCalculator.com/issues">{L('Report a data issue','反馈数据问题')} →</a></p><p class="footnote">{L('Change log · October 18, 2026: first research snapshot; 2025 estimates, direct hourly benchmarks and separate China coverage.','版本记录 · 2026年10月18日：首版研究快照，包含2025年估计、直接时薪指标与中国单列数据。')}</p></section>
</article></main><footer><a href={zh?'/zh/':'/'}>Hourly Income Calculator</a><span>{L('Data year and method travel with every number.','引用数字时，请保留年份与口径。')}</span></footer>
<script>
const select=document.querySelector('#comparison-hours');
select?.addEventListener('change',()=>{const hours=Number(select.value),annualHours=hours*52;const zh=document.documentElement.lang==='zh-Hans';const format=(n,d=2)=>new Intl.NumberFormat(zh?'zh-CN':'en-US',{minimumFractionDigits:d,maximumFractionDigits:d}).format(n);document.querySelectorAll('tbody tr[data-annual]').forEach(row=>{row.querySelector('.local').textContent=format(Number(row.dataset.annual)/annualHours);row.querySelector('.ppp').textContent=format(Number(row.dataset.ppp)/annualHours);const link=row.querySelector('.try'),url=new URL(link.href);url.searchParams.set('rate',(Number(row.dataset.annual)/annualHours).toFixed(6));url.searchParams.set('hours',String(hours));link.href=url.toString();});document.querySelector('#hours-note').textContent=format(annualHours,0)+(zh?' 小时/年':' hours/year');document.querySelector('.assumption').textContent=`(${hours} × 52)`;});
</script>
